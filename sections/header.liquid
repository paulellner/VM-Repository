<style>
.vm-header {
  background:     var(--vm-ink);
  color:          var(--vm-bone);
  border-bottom:  var(--vm-stroke-2, 2.5px) solid var(--vm-ink);
  position:       sticky;
  top:            0;
  z-index:        100;
}

.vm-header__inner {
  max-width:       1200px;
  margin:          0 auto;
  padding:         0 40px;
  height:          72px;
  display:         flex;
  align-items:     center;
  justify-content: space-between;
}

.vm-header__logo {
  text-decoration: none;
  color:           var(--vm-bone);
  font-family:     'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:       22px;
  letter-spacing:  -0.045em;
  line-height:     1;
  display:         flex;
  align-items:     center;
  gap:             2px;
}

.vm-header__logo-velo  { font-weight: 400; }
.vm-header__logo-match { font-weight: 700; }
.vm-header__logo-dot   { color: var(--vm-signal); font-weight: 700; }

.vm-header__nav {
  display:    flex;
  align-items: center;
  gap:         32px;
  list-style:  none;
  margin:      0;
  padding:     0;
}

.vm-header__nav a {
  text-decoration: none;
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  transition:      color var(--vm-dur, 220ms) var(--vm-ease, ease);
}

.vm-header__nav a:hover,
.vm-header__nav a[aria-current="page"] { color: var(--vm-bone); }

.vm-header__cart {
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  border:          none;
  padding:         8px 16px;
  font-family:     var(--vm-sans);
  font-size:       13px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.05em;
  cursor:          pointer;
  text-decoration: none;
  display:         flex;
  align-items:     center;
  gap:             8px;
  transition:      box-shadow var(--vm-dur, 220ms) var(--vm-ease, ease),
                   transform  var(--vm-dur, 220ms) var(--vm-ease, ease);
}

@media (prefers-reduced-motion: no-preference) {
  .vm-header__cart:hover {
    transform:  translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--vm-olive);
  }
}

/* Cart icon wrapper + count badge */
.vm-header__cart-icon {
  position: relative;
  display:  inline-flex;
  flex-shrink: 0;
}

.vm-header__cart-badge {
  position:        absolute;
  top:             -8px;
  right:           -9px;
  min-width:       17px;
  height:          17px;
  background:      var(--vm-ink);
  color:           var(--vm-signal);
  font-size:       10px;
  font-weight:     800;
  font-family:     'Courier New', monospace;
  display:         flex;
  align-items:     center;
  justify-content: center;
  padding:         0 3px;
  line-height:     1;
  border-radius:   0;
}
.vm-header__cart-badge:empty { display: none; }

@media (max-width: 880px) {
  .vm-header__inner     { padding: 0 20px; }
  .vm-header__nav       { display: none; }
  .vm-header__cart-text { display: none; }
  .vm-header__cart      { padding: 10px 14px; min-width: 44px; justify-content: center; }
}
</style>

<header class="vm-header" role="banner">
  <div class="vm-header__inner">

    <a class="vm-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" onclick="try{localStorage.removeItem('vm_selection')}catch(e){}">
      <span class="vm-header__logo-velo">velo</span><span class="vm-header__logo-match">match</span><span class="vm-header__logo-dot">.</span>
    </a>

    <nav aria-label="Hauptnavigation">
      <ul class="vm-header__nav">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a class="vm-header__cart" href="{{ routes.cart_url }}" aria-label="Warenkorb">
      <span class="vm-header__cart-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="vm-header__cart-badge" id="vm-cart-count">
          {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
        </span>
      </span>
      <span class="vm-header__cart-text">Warenkorb</span>
    </a>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigationsmenü",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
