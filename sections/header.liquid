<style>
.vm-header {
  background:     var(--vm-ink);
  color:          var(--vm-bone);
  border-bottom:  var(--vm-stroke-2, 2.5px) solid var(--vm-ink);
  position:       sticky;
  top:            0;
  z-index:        100;
}

.vm-header__inner {
  max-width:       1200px;
  margin:          0 auto;
  padding:         0 40px;
  height:          72px;
  display:         flex;
  align-items:     center;
  justify-content: space-between;
}

.vm-header__logo {
  text-decoration: none;
  color:           var(--vm-bone);
  font-family:     'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:       22px;
  letter-spacing:  -0.045em;
  line-height:     1;
  display:         flex;
  align-items:     center;
  gap:             0;
}

.vm-header__logo-velo  { font-weight: 400; }
.vm-header__logo-match { font-weight: 700; }
.vm-header__logo-dot   { color: var(--vm-signal); font-weight: 700; }

.vm-header__nav {
  display:    flex;
  align-items: center;
  gap:         32px;
  list-style:  none;
  margin:      0;
  padding:     0;
}

.vm-header__nav a {
  text-decoration: none;
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  transition:      color var(--vm-dur, 220ms) var(--vm-ease, ease);
}

.vm-header__nav a:hover,
.vm-header__nav a[aria-current="page"] { color: var(--vm-bone); }

/* VM Pro nav — compact wordmark */
.vm-header__nav-pro {
  display:         inline-flex !important;
  align-items:     center !important;
  gap:             0 !important;
  color:           inherit !important;
  text-decoration: none !important;
  font-family:     'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  letter-spacing:  -0.045em !important;
  padding:         0 !important;
  font-weight:     400 !important;
  text-transform:  none !important;
}
.vm-header__nav-pro-velo  { font-weight: 400; color: var(--vm-sage); transition: color 220ms ease; }
.vm-header__nav-pro-match { font-weight: 700; color: var(--vm-sage); transition: color 220ms ease; }
.vm-header__nav-pro-tag {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  font-family:    'Helvetica Neue', Arial, sans-serif;
  font-size:      9px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        2px 6px;
  line-height:    1.5;
  flex-shrink:    0;
  margin-left:    6px;
}
.vm-header__nav-pro:hover .vm-header__nav-pro-velo,
.vm-header__nav-pro:hover .vm-header__nav-pro-match { color: var(--vm-bone); }

.vm-header__cart {
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  border:          none;
  padding:         8px 16px;
  font-family:     var(--vm-sans);
  font-size:       13px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.05em;
  cursor:          pointer;
  text-decoration: none;
  display:         flex;
  align-items:     center;
  gap:             8px;
  transition:      box-shadow var(--vm-dur, 220ms) var(--vm-ease, ease),
                   transform  var(--vm-dur, 220ms) var(--vm-ease, ease);
}

@media (prefers-reduced-motion: no-preference) {
  .vm-header__cart:hover {
    transform:  translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--vm-olive);
  }
}

/* Cart icon wrapper + count badge */
.vm-header__cart-icon {
  position: relative;
  display:  inline-flex;
  flex-shrink: 0;
}

.vm-header__cart-badge {
  position:        absolute;
  top:             -8px;
  right:           -9px;
  min-width:       17px;
  height:          17px;
  background:      var(--vm-ink);
  color:           var(--vm-signal);
  font-size:       10px;
  font-weight:     800;
  font-family:     'Courier New', monospace;
  display:         flex;
  align-items:     center;
  justify-content: center;
  padding:         0 3px;
  line-height:     1;
  border-radius:   0;
}
.vm-header__cart-badge:empty { display: none; }

/* Account / VM Pro icon */
.vm-header__account {
  position:    relative;
  display:     flex;
  align-items: center;
  color:       var(--vm-sage, #9CA982);
  text-decoration: none;
  padding:     8px;
  transition:  color 220ms ease;
}
.vm-header__account:hover          { color: var(--vm-bone, #F2F0E6); }
.vm-header__account--pro           { color: var(--vm-signal, #C9E45B); }
.vm-header__pro-badge {
  position:    absolute;
  top:         2px;
  right:       2px;
  font-size:   7px;
  font-weight: 800;
  font-family: 'Courier New', monospace;
  color:       var(--vm-ink, #14160F);
  background:  var(--vm-signal, #C9E45B);
  padding:     1px 3px;
  letter-spacing: 0.05em;
  line-height: 1.4;
  pointer-events: none;
}

.vm-header__actions {
  display:    flex;
  align-items: center;
  gap:        4px;
  flex-shrink: 0;
}

/* ── MOBILE HAMBURGER ─────────────────────────────────────────────────── */

.vm-header__burger {
  display:         none;
  align-items:     center;
  justify-content: center;
  width:           44px;
  height:          44px;
  background:      transparent;
  border:          none;
  cursor:          pointer;
  color:           var(--vm-bone);
  padding:         0;
  flex-shrink:     0;
}

/* ── MOBILE NAV DRAWER ───────────────────────────────────────────────── */

.vm-mobile-nav {
  display:    none;
  position:   fixed;
  inset:      0;
  background: var(--vm-ink);
  z-index:    200;
  flex-direction: column;
  overflow-y: auto;
}

.vm-mobile-nav.is-open { display: flex; }

.vm-mobile-nav__top {
  display:         flex;
  align-items:     center;
  justify-content: space-between;
  padding:         0 20px;
  height:          72px;
  border-bottom:   1px solid rgba(156, 169, 130, 0.2);
  flex-shrink:     0;
}

.vm-mobile-nav__logo {
  text-decoration: none;
  color:           var(--vm-bone);
  font-family:     'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:       22px;
  letter-spacing:  -0.045em;
  line-height:     1;
}
.vm-mobile-nav__logo-velo  { font-weight: 400; }
.vm-mobile-nav__logo-match { font-weight: 700; }
.vm-mobile-nav__logo-dot   { color: var(--vm-signal); font-weight: 700; }

.vm-mobile-nav__close {
  display:         flex;
  align-items:     center;
  justify-content: center;
  width:           44px;
  height:          44px;
  background:      transparent;
  border:          none;
  cursor:          pointer;
  color:           var(--vm-bone);
  padding:         0;
}

.vm-mobile-nav__links {
  list-style: none;
  margin:     0;
  padding:    32px 0;
  flex:       1;
}

.vm-mobile-nav__links li {
  border-bottom: 1px solid rgba(156, 169, 130, 0.12);
}

.vm-mobile-nav__links a {
  display:         block;
  padding:         20px 28px;
  text-decoration: none;
  font-size:       17px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.06em;
  color:           var(--vm-sage);
  transition:      color 180ms ease, background 180ms ease;
}

.vm-mobile-nav__links a:hover,
.vm-mobile-nav__links a[aria-current="page"] {
  color:      var(--vm-bone);
  background: rgba(156, 169, 130, 0.06);
}

.vm-mobile-nav__pro-link {
  display:         flex !important;
  align-items:     center !important;
  gap:             0 !important;
  font-family:     'Space Grotesk', 'Helvetica Neue', Arial, sans-serif !important;
  letter-spacing:  -0.045em !important;
  text-transform:  none !important;
  font-size:       20px !important;
  padding:         20px 28px !important;
}

.vm-mobile-nav__pro-link-velo  { font-weight: 400; color: var(--vm-sage); }
.vm-mobile-nav__pro-link-match { font-weight: 700; color: var(--vm-sage); }
.vm-mobile-nav__pro-link-tag {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  font-family:    'Helvetica Neue', Arial, sans-serif;
  font-size:      10px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        3px 7px;
  line-height:    1.5;
  margin-left:    8px;
}

.vm-mobile-nav__links li:has(.vm-mobile-nav__pro-link) {
  border-bottom: none;
  margin-top:    auto;
}

.vm-mobile-nav__bottom {
  padding:    24px 28px;
  border-top: 1px solid rgba(156, 169, 130, 0.12);
  flex-shrink: 0;
}

.vm-mobile-nav__account-row {
  display:    flex;
  align-items: center;
  gap:        16px;
}

.vm-mobile-nav__account-link {
  display:     flex;
  align-items: center;
  gap:         10px;
  text-decoration: none;
  font-size:   13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color:       var(--vm-sage);
  transition:  color 180ms ease;
}

.vm-mobile-nav__account-link:hover { color: var(--vm-bone); }

@media (max-width: 880px) {
  .vm-header__inner     { padding: 0 20px; }
  .vm-header__nav       { display: none; }
  .vm-header__cart-text { display: none; }
  .vm-header__cart      { padding: 10px 14px; min-width: 44px; justify-content: center; }
  .vm-header__account   { padding: 8px 6px; }
  .vm-header__burger    { display: flex; }
}
</style>

<header class="vm-header" role="banner">
  <div class="vm-header__inner">

    <a class="vm-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}" onclick="try{localStorage.removeItem('vm_selection')}catch(e){}">
      <span class="vm-header__logo-velo">velo</span><span class="vm-header__logo-match">match</span><span class="vm-header__logo-dot">.</span>
    </a>

    <nav aria-label="Hauptnavigation">
      <ul class="vm-header__nav">
        {%- for link in section.settings.menu.links -%}
          {%- unless link.title == 'Katalog' or link.title == 'katalog' -%}
          <li>
            <a href="{{ link.url }}"
               {% if link.active %}aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
          </li>
          {%- endunless -%}
          {%- if forloop.index == 1 -%}
            <li>
              <a class="vm-header__nav-pro" href="/pages/velomatch-pro" aria-label="velomatch Pro">
                <span class="vm-header__nav-pro-velo">velo</span><span class="vm-header__nav-pro-match">match</span>
                <span class="vm-header__nav-pro-tag">PRO</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="vm-header__actions">

    <!-- Hamburger (mobile only) -->
    <button class="vm-header__burger"
            aria-label="Navigation öffnen"
            aria-expanded="false"
            aria-controls="vm-mobile-nav"
            onclick="document.getElementById('vm-mobile-nav').classList.add('is-open'); this.setAttribute('aria-expanded','true'); document.body.style.overflow='hidden';">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6"  x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>

    <!-- VM Pro account icon -->
    {%- if customer -%}
      <a class="vm-header__account{% if customer.tags contains 'vm-pro' %} vm-header__account--pro{% endif %}"
         href="{{ routes.account_url }}"
         aria-label="Mein VM Pro Konto">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        {%- if customer.tags contains 'vm-pro' -%}
          <span class="vm-header__pro-badge">PRO</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <a class="vm-header__account"
         href="{{ routes.account_login_url }}"
         aria-label="Anmelden / VM Pro">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
    {%- endif -%}

    <a class="vm-header__cart" href="{{ routes.cart_url }}" aria-label="Warenkorb">
      <span class="vm-header__cart-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5"
             stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="vm-header__cart-badge" id="vm-cart-count">
          {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
        </span>
      </span>
      <span class="vm-header__cart-text">Warenkorb</span>
    </a>

    </div><!-- /.vm-header__actions -->

  </div>
</header>

<!-- ── MOBILE NAV DRAWER ──────────────────────────────────────────────────── -->
<nav id="vm-mobile-nav" class="vm-mobile-nav" aria-label="Mobile Navigation" aria-hidden="true">

  <div class="vm-mobile-nav__top">
    <a class="vm-mobile-nav__logo" href="{{ routes.root_url }}" onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
      <span class="vm-mobile-nav__logo-velo">velo</span><span class="vm-mobile-nav__logo-match">match</span><span class="vm-mobile-nav__logo-dot">.</span>
    </a>
    <button class="vm-mobile-nav__close"
            aria-label="Navigation schließen"
            onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.querySelector('.vm-header__burger').setAttribute('aria-expanded','false'); document.body.style.overflow='';">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <ul class="vm-mobile-nav__links">
    {%- for link in section.settings.menu.links -%}
      {%- unless link.title == 'Katalog' or link.title == 'katalog' -%}
        <li>
          <a href="{{ link.url }}"
             {% if link.active %}aria-current="page"{% endif %}
             onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
            {{ link.title }}
          </a>
        </li>
      {%- endunless -%}
    {%- endfor -%}
    <li>
      <a class="vm-mobile-nav__pro-link" href="/pages/velomatch-pro"
         onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
        <span class="vm-mobile-nav__pro-link-velo">velo</span><span class="vm-mobile-nav__pro-link-match">match</span>
        <span class="vm-mobile-nav__pro-link-tag">PRO</span>
      </a>
    </li>
  </ul>

  <div class="vm-mobile-nav__bottom">
    <div class="vm-mobile-nav__account-row">
      {%- if customer -%}
        <a class="vm-mobile-nav__account-link"
           href="{{ routes.account_url }}"
           onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          Mein Konto
        </a>
      {%- else -%}
        <a class="vm-mobile-nav__account-link"
           href="{{ routes.account_login_url }}"
           onclick="document.getElementById('vm-mobile-nav').classList.remove('is-open'); document.body.style.overflow='';">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          Anmelden
        </a>
      {%- endif -%}
    </div>
  </div>

</nav>
<script>
(function () {
  var nav = document.getElementById('vm-mobile-nav');
  if (!nav) return;
  /* Close on Escape key */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && nav.classList.contains('is-open')) {
      nav.classList.remove('is-open');
      document.body.style.overflow = '';
      var burger = document.querySelector('.vm-header__burger');
      if (burger) burger.setAttribute('aria-expanded', 'false');
    }
  });
  /* Sync aria-hidden with open state */
  var observer = new MutationObserver(function () {
    nav.setAttribute('aria-hidden', nav.classList.contains('is-open') ? 'false' : 'true');
  });
  observer.observe(nav, { attributes: true, attributeFilter: ['class'] });
})();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigationsmenü",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
