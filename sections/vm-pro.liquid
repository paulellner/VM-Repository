<style>
/* ── VeloMatch Pro — Landing Page (Design-Refresh) ─────────────────────── */

.vm-pro-page__section {
  --vm-olive:  #3D4A2F;
  --vm-ink:    #14160F;
  --vm-bone:   #F2F0E6;
  --vm-paper:  #FBFAF3;
  --vm-signal: #C9E45B;
  --vm-sage:   #9CA982;
  --vm-sans:   'Helvetica Neue', Arial, sans-serif;
  --vm-mono:   'Courier New', 'Lucida Console', monospace;
  --vm-stroke: 1.5px;

  background:  var(--vm-bone);
  font-family: var(--vm-sans);
  color:       var(--vm-ink);
  box-sizing:  border-box;
}
.vm-pro-page__section *,
.vm-pro-page__section *::before,
.vm-pro-page__section *::after { box-sizing: inherit; }

.vm-pro-page__inner {
  max-width: 1120px;
  margin:    0 auto;
  padding:   80px 40px 104px;
}

/* Gemeinsame Mono-Label-Optik mit Signal-Strich */
.vm-pro-page__features-heading,
.vm-pro-page__benefits-label,
.vm-pro-page__faq-heading {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color:          var(--vm-sage);
  display:        flex;
  align-items:    center;
  gap:            12px;
}
.vm-pro-page__features-heading::before,
.vm-pro-page__benefits-label::before,
.vm-pro-page__faq-heading::before {
  content: ''; width: 26px; height: 2px; background: var(--vm-signal); flex-shrink: 0;
}

/* ── HERO — editorial, linksbündig ───────────────────────────────────────── */
.vm-pro-page__hero {
  text-align:     left;
  position:       relative;
  margin-bottom:  72px;
  padding-bottom: 56px;
  border-bottom:  var(--vm-stroke) solid var(--vm-olive);
}
.vm-pro-page__hero::after {
  content: ''; position: absolute; left: 0; bottom: -2.5px;
  width: 128px; height: 4px; background: var(--vm-signal);
}

.vm-pro-page__hero-eyebrow {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color:          var(--vm-olive);
  margin-bottom:  28px;
  display:        inline-flex;
  align-items:    center;
  gap:            12px;
}
.vm-pro-page__hero-eyebrow::before {
  content: ''; width: 28px; height: 2px; background: var(--vm-signal);
}

.vm-pro-wordmark {
  display:         inline-flex;
  align-items:     center;
  justify-content: flex-start;
  gap:             0;
  font-family:     var(--vm-sans);
  font-size:       clamp(52px, 10vw, 120px);
  line-height:     0.92;
  margin:          0 0 32px;
  letter-spacing:  -0.045em;
  text-transform:  uppercase;
}
.vm-pro-wordmark__velo  { font-weight: 300; color: var(--vm-ink); }
.vm-pro-wordmark__match { font-weight: 800; color: var(--vm-ink); }
.vm-pro-wordmark__tag {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  font-family:    var(--vm-sans);
  font-size:      0.19em;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  padding:        0.4em 0.72em 0.34em;
  line-height:    1.3;
  align-self:     center;
  flex-shrink:    0;
  margin-left:    0.5em;
}

.vm-pro-page__hero-tagline {
  font-size:   clamp(21px, 2.6vw, 30px);
  font-weight: 500;
  color:       var(--vm-ink);
  line-height: 1.3;
  margin:      0;
  max-width:   680px;
  letter-spacing: -0.01em;
}
.vm-pro-page__hero-accent {
  color:       var(--vm-ink);
  font-weight: 700;
  background:  linear-gradient(transparent 62%, var(--vm-signal) 62%);
  padding:     0 3px;
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* ── FEATURE CARDS — editoriale Nummern-Kacheln ─────────────────────────── */
.vm-pro-page__features { margin-bottom: 72px; }
.vm-pro-page__features-heading { margin-bottom: 28px; }

.vm-pro-page__cards {
  display:               grid;
  grid-template-columns: 1fr 1fr;
  gap:                   0;
  border:                var(--vm-stroke) solid var(--vm-ink);
  background:            var(--vm-ink);
}
.vm-pro-page__card {
  background:      var(--vm-paper);
  padding:        44px 40px;
  position:       relative;
  display:        grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: auto auto 1fr;
  column-gap:     28px;
  transition:     background 280ms cubic-bezier(0.2,0.7,0.2,1),
                  color 280ms cubic-bezier(0.2,0.7,0.2,1);
}
.vm-pro-page__card:nth-child(odd)   { border-right:  var(--vm-stroke) solid var(--vm-ink); }
.vm-pro-page__card:nth-child(-n+2)  { border-bottom: var(--vm-stroke) solid var(--vm-ink); }

.vm-pro-page__card-num {
  grid-column: 1; grid-row: 1 / -1;
  font-family:    var(--vm-mono);
  font-size:      clamp(34px, 4.4vw, 54px);
  font-weight:    400;
  letter-spacing: -0.03em;
  line-height:    0.8;
  color:          var(--vm-sage);
  margin:         2px 0 0;
  transition:     color 280ms ease;
}

.vm-pro-page__card-icon {
  grid-column: 2; grid-row: 1;
  width: auto; height: auto; border: none; background: none;
  color: var(--vm-olive);
  margin: 0 0 18px;
  transition: color 280ms ease;
}
.vm-pro-page__card-icon svg { width: 26px; height: 26px; }

.vm-pro-page__card-title {
  grid-column: 2; grid-row: 2;
  font-size:      23px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height:    1.0;
  margin:         0 0 12px;
}
.vm-pro-page__card-desc {
  grid-column: 2; grid-row: 3;
  font-size:   14px;
  line-height: 1.6;
  color:       var(--vm-sage);
  margin:      0;
  transition:  color 280ms ease;
}

/* Hover: Kachel invertiert auf Ink + Signal-Akzente */
@media (hover: hover) {
  .vm-pro-page__card:hover { background: var(--vm-ink); color: var(--vm-bone); }
  .vm-pro-page__card:hover .vm-pro-page__card-num  { color: var(--vm-signal); }
  .vm-pro-page__card:hover .vm-pro-page__card-icon { color: var(--vm-signal); }
  .vm-pro-page__card:hover .vm-pro-page__card-title { color: var(--vm-bone); }
  .vm-pro-page__card:hover .vm-pro-page__card-desc { color: rgba(242,240,230,0.72); }
}

/* Badge (falls in Karten genutzt) */
.vm-pro-page__card-badge {
  grid-column: 2; grid-row: 4;
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background:     var(--vm-ink);
  color:          var(--vm-bone);
  padding:        3px 8px;
  margin-top:     16px;
  align-self:     flex-start;
}

/* ── BENEFITS STRIP ─────────────────────────────────────────────────────── */
.vm-pro-page__benefits {
  background:    var(--vm-ink);
  color:         var(--vm-bone);
  padding:       36px 44px;
  margin-bottom: 72px;
  border:        var(--vm-stroke) solid var(--vm-ink);
  position:      relative;
}
.vm-pro-page__benefits::before {
  content: ''; position: absolute; top: 0; left: 0; width: 6px; height: 100%; background: var(--vm-signal);
}
.vm-pro-page__benefits-label { color: var(--vm-sage); margin-bottom: 22px; }
.vm-pro-page__benefits-label::before { background: var(--vm-signal); }
.vm-pro-page__benefits-list {
  list-style: none; padding: 0; margin: 0;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px 36px;
}
.vm-pro-page__benefits-list li {
  font-size: 14px; font-weight: 600; color: rgba(242,240,230,0.9);
  display: flex; align-items: baseline; gap: 12px;
}
.vm-pro-page__benefits-list li::before {
  content: '›'; color: var(--vm-signal); font-family: var(--vm-mono);
  font-weight: 700; font-size: 15px; flex-shrink: 0;
}
@media (max-width: 900px) {
  .vm-pro-page__benefits      { padding: 28px 22px 28px 26px; }
  .vm-pro-page__benefits-list { grid-template-columns: 1fr 1fr; }
}

/* ── PRICING BOX ────────────────────────────────────────────────────────── */
.vm-pro-page__pricing { margin-bottom: 80px; }
.vm-pro-page__pricing-box {
  background:  var(--vm-olive);
  color:       var(--vm-bone);
  border:      2px solid var(--vm-ink);
  padding:     52px 56px 52px 64px;
  display:     flex;
  align-items: center;
  gap:         64px;
  flex-wrap:   wrap;
  position:    relative;
  overflow:    hidden;
}
.vm-pro-page__pricing-box::before {
  content: ''; position: absolute; top: 0; left: 0; width: 8px; height: 100%; background: var(--vm-signal);
}
.vm-pro-page__pricing-left { flex: 0 0 auto; }
.vm-pro-page__pricing-amount {
  font-family: var(--vm-mono); font-size: 76px; font-weight: 400;
  letter-spacing: -0.04em; line-height: 1; color: var(--vm-signal);
}
.vm-pro-page__pricing-period {
  font-family: var(--vm-mono); font-size: 13px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.14em; color: var(--vm-sage); margin-top: 10px;
}
.vm-pro-page__pricing-note { font-size: 13px; color: var(--vm-sage); margin-top: 8px; line-height: 1.4; }
.vm-pro-page__pricing-right { flex: 1; min-width: 260px; }
.vm-pro-page__pricing-desc {
  font-size: 18px; line-height: 1.55; color: var(--vm-bone); margin-bottom: 32px; opacity: 0.9;
}

.vm-pro-page__cta-btn {
  display: inline-block; background: var(--vm-signal); color: var(--vm-ink);
  text-decoration: none; font-family: var(--vm-sans); font-size: 15px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.01em; padding: 16px 38px; border: none; cursor: pointer;
  transition: transform 220ms cubic-bezier(0.2,0.7,0.2,1), box-shadow 220ms cubic-bezier(0.2,0.7,0.2,1);
}
@media (prefers-reduced-motion: no-preference) {
  .vm-pro-page__cta-btn:hover { transform: translate(-3px,-3px); box-shadow: 6px 6px 0 var(--vm-bone); }
}
.vm-pro-page__already-pro { display: flex; align-items: center; gap: 16px; }
.vm-pro-page__pro-check { font-size: 22px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; color: var(--vm-signal); }
.vm-pro-page__pro-detail { font-size: 14px; color: var(--vm-sage); line-height: 1.5; margin: 12px 0 24px; }

/* ── FAQ — mit CSS-Nummerierung ─────────────────────────────────────────── */
.vm-pro-page__faq { border-top: var(--vm-stroke) solid var(--vm-olive); padding-top: 56px; }
.vm-pro-page__faq-heading { margin-bottom: 36px; }
.vm-pro-page__faq-list {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
  border: var(--vm-stroke) solid var(--vm-ink); counter-reset: vmfaq;
}
.vm-pro-page__faq-item {
  padding: 40px 32px 36px; border-right: var(--vm-stroke) solid var(--vm-ink);
  background: var(--vm-paper); position: relative;
}
.vm-pro-page__faq-item:last-child { border-right: none; }
.vm-pro-page__faq-q {
  font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em;
  line-height: 1.15; margin: 0 0 14px; color: var(--vm-ink); position: relative; padding-top: 26px;
}
.vm-pro-page__faq-q::before {
  counter-increment: vmfaq; content: 'F0' counter(vmfaq);
  position: absolute; top: 0; left: 0;
  font-family: var(--vm-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; color: var(--vm-signal);
}
.vm-pro-page__faq-a { font-size: 14px; line-height: 1.65; color: var(--vm-sage); margin: 0; }

/* ── RESPONSIVE ─────────────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .vm-pro-page__inner       { padding: 56px 22px 72px; }
  .vm-pro-page__cards       { grid-template-columns: 1fr; }
  .vm-pro-page__card        { border-right: none !important; }
  .vm-pro-page__card:not(:last-child) { border-bottom: var(--vm-stroke) solid var(--vm-ink); }
  .vm-pro-page__pricing-box { padding: 40px 28px 40px 34px; flex-direction: column; align-items: flex-start; gap: 32px; }
  .vm-pro-page__pricing-amount { font-size: 60px; }
  .vm-pro-page__faq-list    { grid-template-columns: 1fr; }
  .vm-pro-page__faq-item    { border-right: none; border-bottom: var(--vm-stroke) solid var(--vm-ink); }
  .vm-pro-page__faq-item:last-child { border-bottom: none; }
}
@media (max-width: 600px) {
  .vm-pro-page__inner        { padding: 40px 16px 56px; }
  .vm-pro-page__hero         { margin-bottom: 52px; padding-bottom: 40px; }
  .vm-pro-wordmark           { font-size: clamp(38px, 13vw, 60px); }
  .vm-pro-page__hero-tagline { font-size: 19px; }
  .vm-pro-page__card         { padding: 30px 22px; column-gap: 20px; }
  .vm-pro-page__card-title   { font-size: 20px; }
  .vm-pro-page__benefits     { padding: 24px 18px 24px 22px; }
  .vm-pro-page__benefits-list { grid-template-columns: 1fr; gap: 12px; }
  .vm-pro-page__pricing-box  { padding: 28px 18px 28px 24px; }
  .vm-pro-page__pricing-amount { font-size: 48px; }
  .vm-pro-page__faq-item     { padding: 30px 20px; }
  .vm-pro-page__cta-btn      { width: 100%; text-align: center; }
}
</style>

<section class="vm-pro-page__section" aria-label="VeloMatch Pro">
  <div class="vm-pro-page__inner">

    <!-- ── HERO ─────────────────────────────────────────────────────────── -->
    <div class="vm-pro-page__hero">
      <span class="vm-pro-page__hero-eyebrow">Premium Mitgliedschaft</span>
      <h1 class="vm-pro-wordmark" aria-label="velomatch Pro">
        <span class="vm-pro-wordmark__velo">velo</span><span class="vm-pro-wordmark__match">match</span>
        <span class="vm-pro-wordmark__tag" aria-hidden="true">PRO</span>
      </h1>
      <p class="vm-pro-page__hero-tagline">
        Dein Rad. Deine Fahrdaten. <span class="vm-pro-page__hero-accent">Dein Verschleiß im Blick.</span>
      </p>
    </div>

    <!-- ── FEATURE CARDS ─────────────────────────────────────────────── -->
    <div class="vm-pro-page__features">
      <p class="vm-pro-page__features-heading">Was du bekommst</p>
      <div class="vm-pro-page__cards" role="list">

        <!-- Card 1: Rad speichern -->
        <div class="vm-pro-page__card vm-pro-page__card--active" role="listitem">
          <span class="vm-pro-page__card-num">01</span>
          <div class="vm-pro-page__card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h2 class="vm-pro-page__card-title">Rad speichern</h2>
          <p class="vm-pro-page__card-desc">
            Marke, Modell, Variante und Schaltgruppe dauerhaft in deinem Konto hinterlegt.
            Kein erneutes Auswählen — sofort loslegen.
          </p>
        </div>

        <!-- Card 2: Strava & Fahrdaten -->
        <div class="vm-pro-page__card vm-pro-page__card--active" role="listitem">
          <span class="vm-pro-page__card-num">02</span>
          <div class="vm-pro-page__card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </div>
          <h2 class="vm-pro-page__card-title">Strava verknüpfen</h2>
          <p class="vm-pro-page__card-desc">
            Verbinde deinen Strava-Account. Deine Fahrdaten — Kilometer,
            Fahrbedingungen, Höhenmeter — fließen direkt in die
            Verschleißberechnung ein.
          </p>
        </div>

        <!-- Card 3: Bike Gesundheit -->
        <div class="vm-pro-page__card vm-pro-page__card--active" role="listitem">
          <span class="vm-pro-page__card-num">03</span>
          <div class="vm-pro-page__card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
            </svg>
          </div>
          <h2 class="vm-pro-page__card-title">Bike Gesundheit</h2>
          <p class="vm-pro-page__card-desc">
            8 Verschleißteile und Verbrauchsmittel werden laufend überwacht:
            Kette, Kassette, Bremsbeläge, Züge, Reifen und mehr — angepasst
            an deine tatsächlichen Fahrbedingungen.
          </p>
        </div>

        <!-- Card 4: Smarte Kaufvorschläge -->
        <div class="vm-pro-page__card vm-pro-page__card--active" role="listitem">
          <span class="vm-pro-page__card-num">04</span>
          <div class="vm-pro-page__card-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
          </div>
          <h2 class="vm-pro-page__card-title">Ersatzempfehlung</h2>
          <p class="vm-pro-page__card-desc">
            Sobald eine Komponente die Verschleißschwelle erreicht, erscheint
            direkt im Dashboard ein Kaufvorschlag — mit dem richtigen Produkt
            für dein Rad, zur richtigen Zeit.
          </p>
        </div>

      </div>
    </div>

    <!-- ── BENEFITS STRIP ───────────────────────────────────────────────── -->
    <div class="vm-pro-page__benefits">
      <span class="vm-pro-page__benefits-label">Inklusive in deiner Mitgliedschaft</span>
      <ul class="vm-pro-page__benefits-list">
        <li>Rad dauerhaft gespeichert</li>
        <li>Strava-Fahrdaten live synchronisiert</li>
        <li>Verschleiß-Monitoring für 8 Komponenten</li>
        <li>Kaufvorschläge auf Basis echter km-Daten</li>
        <li>Fahrbedingungen (Nässe, Watt, Höhenmeter) eingerechnet</li>
        <li>Jederzeit kündbar — kein Restrisiko</li>
      </ul>
    </div>

    <!-- ── PRICING ───────────────────────────────────────────────────── -->
    <div class="vm-pro-page__pricing">

      {%- if customer -%}
        {%- if customer.tags contains 'vm-pro' -%}

          <!-- Already Pro -->
          <div class="vm-pro-page__pricing-box">
            <div class="vm-pro-page__pricing-left">
              <div class="vm-pro-page__pricing-amount">PRO</div>
              <p class="vm-pro-page__pricing-period">Pro-Mitglied</p>
            </div>
            <div class="vm-pro-page__pricing-right">
              <div class="vm-pro-page__already-pro">
                <span class="vm-pro-page__pro-check">Du bist bereits Pro ✓</span>
              </div>
              <p class="vm-pro-page__pro-detail">
                Dein Pro-Zugang ist aktiv. Alle Funktionen stehen dir zur Verfügung.
              </p>
              <a class="vm-pro-page__cta-btn" href="/pages/vm-pro-dashboard">
                Zum Pro Dashboard →
              </a>
            </div>
          </div>

        {%- else -%}

          <!-- Logged in but not Pro — upgrade prompt -->
          <div class="vm-pro-page__pricing-box">
            <div class="vm-pro-page__pricing-left">
              <div class="vm-pro-page__pricing-amount">5.99€</div>
              <p class="vm-pro-page__pricing-period">pro Monat</p>
              <p class="vm-pro-page__pricing-note">Jederzeit kündbar.</p>
            </div>
            <div class="vm-pro-page__pricing-right">
              <p class="vm-pro-page__pricing-desc">
                Verbinde Strava, speichere dein Rad und lass VM Pro den
                Verschleiß für dich im Auge behalten — mit Kaufvorschlägen
                genau dann, wenn sie gebraucht werden.
              </p>
              <a class="vm-pro-page__cta-btn"
                 href="{{ section.settings.pro_product_url | default: '/products/velomatch-pro' }}">
                Jetzt upgraden →
              </a>
            </div>
          </div>

        {%- endif -%}
      {%- else -%}

        <!-- Not logged in — standard pricing -->
        <div class="vm-pro-page__pricing-box">
          <div class="vm-pro-page__pricing-left">
            <div class="vm-pro-page__pricing-amount">5.99€</div>
            <p class="vm-pro-page__pricing-period">pro Monat</p>
            <p class="vm-pro-page__pricing-note">Jederzeit kündbar.</p>
          </div>
          <div class="vm-pro-page__pricing-right">
            <p class="vm-pro-page__pricing-desc">
              Verbinde Strava, speichere dein Rad und lass VM Pro den
              Verschleiß für dich im Auge behalten — mit Kaufvorschlägen
              genau dann, wenn sie gebraucht werden.
            </p>
            <a class="vm-pro-page__cta-btn"
               href="{{ section.settings.pro_product_url | default: '/products/velomatch-pro' }}">
              Jetzt starten →
            </a>
          </div>
        </div>

      {%- endif -%}
    </div>

    <!-- ── FAQ ───────────────────────────────────────────────────────── -->
    <div class="vm-pro-page__faq">
      <p class="vm-pro-page__faq-heading">Häufige Fragen</p>
      <div class="vm-pro-page__faq-list" role="list">

        <div class="vm-pro-page__faq-item" role="listitem">
          <h3 class="vm-pro-page__faq-q">Was ist VM Pro?</h3>
          <p class="vm-pro-page__faq-a">
            VeloMatch Pro ist eine monatliche Mitgliedschaft mit persönlichem
            Dashboard: Rad speichern, Strava verknüpfen, Verschleiß live
