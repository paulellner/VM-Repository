<style>
/* ── Impressum ───────────────────────────────────────────────────────────── */

.vm-impressum {
  --vm-olive:  #3D4A2F;
  --vm-ink:    #14160F;
  --vm-bone:   #F2F0E6;
  --vm-paper:  #FBFAF3;
  --vm-signal: #C9E45B;
  --vm-sage:   #9CA982;
  --vm-sans:   'Helvetica Neue', Arial, sans-serif;
  --vm-mono:   'Courier New', 'Lucida Console', monospace;
  --vm-stroke: 1.5px;

  background:  var(--vm-bone);
  font-family: var(--vm-sans);
  color:       var(--vm-ink);
  box-sizing:  border-box;
}
.vm-impressum *, .vm-impressum *::before, .vm-impressum *::after { box-sizing: inherit; }

.vm-impressum__inner {
  max-width: 800px;
  margin:    0 auto;
  padding:   64px 40px 96px;
}

.vm-impressum__eyebrow {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  16px;
}

.vm-impressum__title {
  font-size:      clamp(32px, 5vw, 52px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  line-height:    1;
  margin:         0 0 48px;
  padding-bottom: 32px;
  border-bottom:  var(--vm-stroke) solid var(--vm-olive);
}

.vm-impressum__block {
  margin-bottom: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(61,74,47,0.15);
}
.vm-impressum__block:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.vm-impressum__block-heading {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  14px;
}

.vm-impressum__text {
  font-size:   15px;
  line-height: 1.7;
  color:       var(--vm-ink);
  margin:      0 0 8px;
}
.vm-impressum__text:last-child { margin-bottom: 0; }

.vm-impressum__text a {
  color:           var(--vm-olive);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition:      color 220ms ease;
}
.vm-impressum__text a:hover { color: var(--vm-ink); }

.vm-impressum__legal {
  font-size:   13px;
  line-height: 1.7;
  color:       var(--vm-sage);
  margin:      0 0 8px;
}
.vm-impressum__legal:last-child { margin-bottom: 0; }

@media (max-width: 600px) {
  .vm-impressum__inner { padding: 40px 20px 64px; }
  .vm-impressum__title { font-size: 32px; margin-bottom: 36px; }
  .vm-impressum__block { margin-bottom: 32px; padding-bottom: 32px; }
}
</style>

<div class="vm-impressum">
  <div class="vm-impressum__inner">

    <span class="vm-impressum__eyebrow">Rechtliches</span>
    <h1 class="vm-impressum__title">Impressum</h1>

    {%- comment -%} ── Angaben gemäß § 5 TMG ──────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Angaben gemäß § 5 TMG</span>
      <p class="vm-impressum__text">{{ section.settings.company_name }}</p>
      {%- if section.settings.company_addition != blank -%}
        <p class="vm-impressum__text">{{ section.settings.company_addition }}</p>
      {%- endif -%}
      <p class="vm-impressum__text">
        {{ section.settings.street }}<br>
        {{ section.settings.zip }} {{ section.settings.city }}<br>
        {{ section.settings.country }}
      </p>
    </div>

    {%- comment -%} ── Kontakt ────────────────────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Kontakt</span>
      {%- if section.settings.phone != blank -%}
        <p class="vm-impressum__text">Telefon: {{ section.settings.phone }}</p>
      {%- endif -%}
      <p class="vm-impressum__text">
        E-Mail: <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      </p>
    </div>

    {%- comment -%} ── USt-IdNr (optional) ────────────────────────────────── {%- endcomment -%}
    {%- if section.settings.vat_id != blank -%}
      <div class="vm-impressum__block">
        <span class="vm-impressum__block-heading">Umsatzsteuer-Identifikationsnummer</span>
        <p class="vm-impressum__text">
          Gemäß § 27a Umsatzsteuergesetz: {{ section.settings.vat_id }}
        </p>
      </div>
    {%- endif -%}

    {%- comment -%} ── Handelsregister (optional) ────────────────────────── {%- endcomment -%}
    {%- if section.settings.register_number != blank -%}
      <div class="vm-impressum__block">
        <span class="vm-impressum__block-heading">Handelsregistereintrag</span>
        <p class="vm-impressum__text">Eingetragen im Handelsregister.</p>
        <p class="vm-impressum__text">Registergericht: {{ section.settings.register_court }}</p>
        <p class="vm-impressum__text">Registernummer: {{ section.settings.register_number }}</p>
      </div>
    {%- endif -%}

    {%- comment -%} ── Verantwortlicher gemäß § 55 Abs. 2 MStV ──────────── {%- endcomment -%}
    {%- if section.settings.responsible_person != blank -%}
      <div class="vm-impressum__block">
        <span class="vm-impressum__block-heading">Verantwortlicher gemäß § 55 Abs. 2 MStV</span>
        <p class="vm-impressum__text">{{ section.settings.responsible_person }}</p>
        {%- if section.settings.responsible_address != blank -%}
          <p class="vm-impressum__text">{{ section.settings.responsible_address }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── EU-Streitschlichtung ───────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">EU-Streitschlichtung</span>
      <p class="vm-impressum__legal">
        Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
        <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener">
          https://ec.europa.eu/consumers/odr/
        </a>.<br>
        Unsere E-Mail-Adresse finden Sie oben im Impressum.
      </p>
    </div>

    {%- comment -%} ── Verbraucherstreitbeilegung ────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Verbraucherstreitbeilegung / Universalschlichtungsstelle</span>
      <p class="vm-impressum__legal">
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </div>

    {%- comment -%} ── Haftung für Inhalte ───────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Haftung für Inhalte</span>
      <p class="vm-impressum__legal">
        Als Diensteanbieter sind wir gemäß § 7 Abs. 1 TMG für eigene Inhalte auf diesen Seiten
        nach den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 TMG sind wir als
        Diensteanbieter jedoch nicht unter Umständen verpflichtet, übermittelte oder gespeicherte
        fremde Informationen zu überwachen oder nach Umständen zu forschen, die auf eine
        rechtswidrige Tätigkeit hinweisen.
      </p>
      <p class="vm-impressum__legal">
        Verpflichtungen zur Entfernung oder Sperrung der Nutzung von Informationen nach den
        allgemeinen Gesetzen bleiben hiervon unberührt. Eine diesbezügliche Haftung ist jedoch
        erst ab dem Zeitpunkt der Kenntnis einer konkreten Rechtsverletzung möglich. Bei
        Bekanntwerden von entsprechenden Rechtsverletzungen werden wir diese Inhalte umgehend entfernen.
      </p>
    </div>

    {%- comment -%} ── Haftung für Links ─────────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Haftung für Links</span>
      <p class="vm-impressum__legal">
        Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir keinen
        Einfluss haben. Deshalb können wir für diese fremden Inhalte auch keine Gewähr übernehmen.
        Für die Inhalte der verlinkten Seiten ist stets der jeweilige Anbieter oder Betreiber der
        Seiten verantwortlich.
      </p>
      <p class="vm-impressum__legal">
        Die verlinkten Seiten wurden zum Zeitpunkt der Verlinkung auf mögliche Rechtsverstöße
        überprüft. Rechtswidrige Inhalte waren zum Zeitpunkt der Verlinkung nicht erkennbar. Eine
        permanente inhaltliche Kontrolle der verlinkten Seiten ist jedoch ohne konkrete
        Anhaltspunkte einer Rechtsverletzung nicht zumutbar. Bei Bekanntwerden von
        Rechtsverletzungen werden wir derartige Links umgehend entfernen.
      </p>
    </div>

    {%- comment -%} ── Urheberrecht ──────────────────────────────────────── {%- endcomment -%}
    <div class="vm-impressum__block">
      <span class="vm-impressum__block-heading">Urheberrecht</span>
      <p class="vm-impressum__legal">
        Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen
        dem deutschen Urheberrecht. Die Vervielfältigung, Bearbeitung, Verbreitung und jede Art der
        Verwertung außerhalb der Grenzen des Urheberrechtes bedürfen der schriftlichen Zustimmung
        des jeweiligen Autors bzw. Erstellers.
      </p>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Impressum",
  "settings": [
    {
      "type": "header",
      "content": "Unternehmensangaben"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Name / Firma",
      "default": "Muster GmbH"
    },
    {
      "type": "text",
      "id": "company_addition",
      "label": "Zusatz (z.B. Geschäftsführer)",
      "default": ""
    },
    {
      "type": "text",
      "id": "street",
      "label": "Straße und Hausnummer",
      "default": "Musterstraße 1"
    },
    {
      "type": "text",
      "id": "zip",
      "label": "PLZ",
      "default": "12345"
    },
    {
      "type": "text",
      "id": "city",
      "label": "Ort",
      "default": "Musterstadt"
    },
    {
      "type": "text",
      "id": "country",
      "label": "Land",
      "default": "Deutschland"
    },
    {
      "type": "header",
      "content": "Kontakt"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Telefon (optional)",
      "default": ""
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-Mail-Adresse",
      "default": "info@example.de"
    },
    {
      "type": "header",
      "content": "Optionale Angaben"
    },
    {
      "type": "text",
      "id": "vat_id",
      "label": "USt-IdNr (leer lassen wenn nicht vorhanden)",
      "default": ""
    },
    {
      "type": "text",
      "id": "register_court",
      "label": "Registergericht (leer lassen wenn nicht eingetragen)",
      "default": ""
    },
    {
      "type": "text",
      "id": "register_number",
      "label": "Registernummer (leer lassen wenn nicht eingetragen)",
      "default": ""
    },
    {
      "type": "header",
      "content": "Verantwortlicher Redakteur"
    },
    {
      "type": "text",
      "id": "responsible_person",
      "label": "Name des Verantwortlichen (§ 55 Abs. 2 MStV)",
      "default": ""
    },
    {
      "type": "text",
      "id": "responsible_address",
      "label": "Anschrift (falls abweichend)",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "Impressum",
      "category": "VeloMatch"
    }
  ]
}
{% endschema %}

