{%- comment -%} sections/vm-pro-dashboard.liquid — VM Pro Members Dashboard {%- endcomment -%}

<style>
/* ── VM Pro Dashboard ────────────────────────────────────────────────────── */
.vmpd {
  --vm-olive:      #3D4A2F;
  --vm-olive-deep: #2A331F;
  --vm-moss:       #5E7142;
  --vm-sage:       #9CA982;
  --vm-signal:     #C9E45B;
  --vm-ink:        #14160F;
  --vm-bone:       #F2F0E6;
  --vm-paper:      #FBFAF3;
  --vm-stroke:     1.5px;
  --vm-stroke-2:   2.5px;
  --vm-mono:       'Courier New', 'Lucida Console', monospace;
  --vm-sans:       'Helvetica Neue', Arial, sans-serif;
  --vm-dur:        220ms;
  --vm-ease:       cubic-bezier(0.2, 0.7, 0.2, 1);

  background:  var(--vm-bone);
  font-family: var(--vm-sans);
  color:       var(--vm-ink);
  min-height:  80vh;
  box-sizing:  border-box;
}
.vmpd *, .vmpd *::before, .vmpd *::after { box-sizing: inherit; }

.vmpd__inner {
  max-width: 1200px;
  margin:    0 auto;
  padding:   0 40px 96px;
}

/* ── AUTH STATES (not logged in / not pro) ──────────────────────────────── */

.vmpd__gate {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  justify-content: center;
  min-height:     60vh;
  text-align:     center;
  padding:        64px 40px;
}

.vmpd__gate-icon {
  width:       56px;
  height:      56px;
  border:      var(--vm-stroke-2) solid var(--vm-ink);
  display:     flex;
  align-items: center;
  justify-content: center;
  margin:      0 auto 24px;
  color:       var(--vm-sage);
}

.vmpd__gate-heading {
  font-size:      clamp(20px, 3vw, 30px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  margin:         0 0 12px;
}

.vmpd__gate-text {
  font-size:   15px;
  line-height: 1.65;
  color:       var(--vm-sage);
  max-width:   440px;
  margin:      0 auto 32px;
}

.vmpd__gate-btn {
  display:         inline-block;
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  text-decoration: none;
  font-family:     var(--vm-sans);
  font-size:       14px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.04em;
  padding:         14px 32px;
  transition:      transform var(--vm-dur) var(--vm-ease),
                   box-shadow var(--vm-dur) var(--vm-ease);
}

@media (prefers-reduced-motion: no-preference) {
  .vmpd__gate-btn:hover {
    transform:  translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--vm-ink);
  }
}

.vmpd__gate-btn--secondary {
  background:      transparent;
  color:           var(--vm-sage);
  border:          var(--vm-stroke) solid rgba(61,74,47,0.3);
  margin-top:      12px;
}
.vmpd__gate-btn--secondary:hover {
  border-color: var(--vm-olive);
  color:        var(--vm-ink);
  box-shadow:   5px 5px 0 var(--vm-sage);
}

/* Upgrade wall — teaser tiles */
.vmpd__upgrade-features {
  display:               grid;
  grid-template-columns: repeat(3, 1fr);
  gap:                   16px;
  max-width:             680px;
  margin:                32px auto 40px;
  text-align:            left;
}

.vmpd__upgrade-feature {
  background:  var(--vm-paper);
  border:      var(--vm-stroke) solid rgba(61,74,47,0.25);
  padding:     20px 20px 16px;
  opacity:     0.55;
  filter:      blur(0px);
}

.vmpd__upgrade-feature-icon {
  color:       var(--vm-sage);
  margin-bottom: 12px;
}

.vmpd__upgrade-feature-name {
  font-size:      13px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color:          var(--vm-ink);
  margin:         0 0 4px;
}

.vmpd__upgrade-feature-text {
  font-size:   12px;
  color:       var(--vm-sage);
  line-height: 1.5;
  margin:      0;
}

/* ── DASHBOARD HEADER ───────────────────────────────────────────────────── */

.vmpd__header {
  background:    var(--vm-ink);
  margin:        0 -40px;
  padding:       40px 40px 36px;
  display:       flex;
  align-items:   flex-end;
  justify-content: space-between;
  gap:           24px;
  flex-wrap:     wrap;
  border-bottom: var(--vm-stroke-2) solid var(--vm-olive);
  margin-bottom: 0;
}

.vmpd__header-left { display: flex; flex-direction: column; gap: 10px; }

/* VM Pro wordmark — Tag Signal variant */
.vmpd__wordmark {
  display:     inline-flex;
  align-items: center;
  gap:         0;
  font-family: 'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:   clamp(28px, 4vw, 44px);
  font-weight: 400;
  letter-spacing: -0.045em;
  line-height: 1;
  text-transform: none;
  margin:      0;
}

.vmpd__wordmark-velo  { font-weight: 400; color: var(--vm-bone); }
.vmpd__wordmark-match { font-weight: 700; color: var(--vm-bone); }
.vmpd__wordmark-tag {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  font-family:    'Helvetica Neue', Arial, sans-serif;
  font-size:      0.33em;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        0.25em 0.6em 0.2em;
  margin-left:    10px;
  line-height:    1.5;
  align-self:     center;
}

.vmpd__header-greeting {
  font-family:    var(--vm-mono);
  font-size:      13px;
  color:          var(--vm-sage);
  letter-spacing: 0.08em;
}

.vmpd__header-greeting strong {
  color:       var(--vm-bone);
  font-weight: 700;
}

.vmpd__header-right {
  display:     flex;
  align-items: flex-end;
  gap:         12px;
  flex-wrap:   wrap;
}

.vmpd__status-chip {
  display:        inline-flex;
  align-items:    center;
  gap:            7px;
  background:     rgba(201,228,91,0.12);
  border:         1px solid rgba(201,228,91,0.35);
  color:          var(--vm-signal);
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  padding:        5px 12px;
}

.vmpd__status-dot {
  width:         7px;
  height:        7px;
  border-radius: 50%;
  background:    var(--vm-signal);
  flex-shrink:   0;
}

.vmpd__header-logout {
  font-family:     var(--vm-mono);
  font-size:       11px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  text-decoration: none;
  opacity:         0.6;
  transition:      opacity var(--vm-dur) ease;
}
.vmpd__header-logout:hover { opacity: 1; color: var(--vm-bone); }

/* ── STATS BAR ──────────────────────────────────────────────────────────── */

.vmpd__stats {
  display:     grid;
  grid-template-columns: repeat(3, 1fr);
  background:  var(--vm-olive);
  border-bottom: var(--vm-stroke-2) solid var(--vm-signal);
  margin:      0 -40px 56px;
}

.vmpd__stat {
  padding:       24px 32px;
  border-right:  1px solid rgba(201,228,91,0.15);
}
.vmpd__stat:last-child { border-right: none; }

.vmpd__stat-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  8px;
}

.vmpd__stat-value {
  font-family:    var(--vm-mono);
  font-size:      22px;
  font-weight:    400;
  color:          var(--vm-signal);
  line-height:    1;
  display:        block;
}

.vmpd__stat-sub {
  font-size:   11px;
  color:       rgba(156,169,130,0.7);
  margin-top:  4px;
  display:     block;
  font-family: var(--vm-mono);
}

/* ── MAIN GRID ──────────────────────────────────────────────────────────── */

.vmpd__grid {
  display:               grid;
  grid-template-columns: 1fr 340px;
  gap:                   32px;
  align-items:           stretch;
  margin-bottom:         32px;
}
.vmpd__grid:last-of-type { margin-bottom: 0; }

/* ── PANEL (shared) ──────────────────────────────────────────────────────── */

.vmpd__panel {
  border:          var(--vm-stroke) solid var(--vm-ink);
  background:      var(--vm-paper);
  display:         flex;
  flex-direction:  column;
}

.vmpd__panel-hd {
  display:       flex;
  align-items:   center;
  gap:           12px;
  padding:       18px 24px;
  border-bottom: var(--vm-stroke) solid var(--vm-ink);
  background:    var(--vm-bone);
}

.vmpd__panel-num {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  color:          var(--vm-sage);
  letter-spacing: 0.1em;
  flex-shrink:    0;
}

.vmpd__panel-title {
  font-size:      15px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color:          var(--vm-ink);
  margin:         0;
  flex:           1;
}

.vmpd__panel-action {
  font-family:     var(--vm-mono);
  font-size:       11px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-moss);
  text-decoration: none;
  opacity:         0.7;
  transition:      opacity var(--vm-dur) ease, color var(--vm-dur) ease;
  flex-shrink:     0;
}
.vmpd__panel-action:hover { opacity: 1; color: var(--vm-olive); }

.vmpd__panel-body { padding: 28px 24px; flex: 1; }

/* ── BIKE PANEL ──────────────────────────────────────────────────────────── */

.vmpd__bike-specs {
  display:               grid;
  grid-template-columns: repeat(2, 1fr);
  border:                var(--vm-stroke) solid rgba(61,74,47,0.2);
  margin-bottom:         24px;
}

.vmpd__bike-spec {
  padding:     16px 18px;
  border-right: var(--vm-stroke) solid rgba(61,74,47,0.2);
  border-bottom: var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__bike-spec:nth-child(2n)      { border-right: none; }
.vmpd__bike-spec:nth-last-child(-n+2) { border-bottom: none; }

.vmpd__bike-spec-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  5px;
}

.vmpd__bike-spec-value {
  font-size:   15px;
  font-weight: 700;
  color:       var(--vm-ink);
  line-height: 1.3;
}

.vmpd__bike-brand {
  font-size:      clamp(22px, 3vw, 32px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  color:          var(--vm-ink);
  margin:         0 0 4px;
  line-height:    1;
}

.vmpd__bike-model {
  font-size:   16px;
  font-weight: 700;
  color:       var(--vm-moss);
  margin:      0 0 20px;
  text-transform: uppercase;
  letter-spacing: -0.01em;
}

.vmpd__parts-btn {
  display:         inline-flex;
  align-items:     center;
  gap:             10px;
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  text-decoration: none;
  font-family:     var(--vm-sans);
  font-size:       13px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.04em;
  padding:         13px 22px;
  transition:      transform var(--vm-dur) var(--vm-ease),
                   box-shadow var(--vm-dur) var(--vm-ease);
}
@media (prefers-reduced-motion: no-preference) {
  .vmpd__parts-btn:hover {
    transform:  translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--vm-olive);
  }
}

.vmpd__selector-link {
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.08em;
  color:           var(--vm-sage);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition:      color var(--vm-dur) ease;
}
.vmpd__selector-link:hover { color: var(--vm-ink); }

/* empty state */
.vmpd__empty {
  display:        flex;
  flex-direction: column;
  align-items:    flex-start;
  gap:            12px;
  padding:        8px 0;
}

.vmpd__empty-label {
  font-size:   15px;
  line-height: 1.65;
  color:       var(--vm-sage);
  margin:      0;
}

/* ── ORDERS PANEL ────────────────────────────────────────────────────────── */

.vmpd__orders-table {
  width:           100%;
  border-collapse: collapse;
  font-size:       13px;
}

.vmpd__orders-table th {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  text-align:     left;
  padding:        0 12px 12px 0;
  border-bottom:  var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__orders-table th:last-child { padding-right: 0; }

.vmpd__orders-table td {
  padding:       13px 12px 13px 0;
  border-bottom: 1px solid rgba(61,74,47,0.1);
  vertical-align: middle;
  color:         var(--vm-ink);
}
.vmpd__orders-table td:last-child { padding-right: 0; }

.vmpd__orders-table tr:last-child td { border-bottom: none; }

.vmpd__order-num {
  font-family:     var(--vm-mono);
  font-weight:     700;
  font-size:       13px;
  color:           var(--vm-olive);
  text-decoration: none;
}
.vmpd__order-num:hover { color: var(--vm-ink); text-decoration: underline; }

.vmpd__order-date {
  font-family: var(--vm-mono);
  font-size:   12px;
  color:       var(--vm-sage);
}

.vmpd__order-total {
  font-family:  var(--vm-mono);
  font-size:    14px;
  font-weight:  700;
  white-space:  nowrap;
}

.vmpd__order-badge {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        2px 7px;
  white-space:    nowrap;
}

.vmpd__order-badge--paid     { background: rgba(201,228,91,0.18); color: var(--vm-olive); }
.vmpd__order-badge--pending  { background: rgba(255,200,50,0.18); color: #8A6800; }
.vmpd__order-badge--refunded { background: rgba(217,79,58,0.12);  color: #9A3520; }

.vmpd__orders-empty {
  padding: 24px 0;
  font-size: 14px;
  color: var(--vm-sage);
}

/* ── SIDE PANELS ─────────────────────────────────────────────────────────── */

/* Strava panel */
.vmpd__strava-logo {
  width:           48px;
  height:          48px;
  border-radius:   50%;
  background:      #FC4C02;
  display:         flex;
  align-items:     center;
  justify-content: center;
  font-family:     var(--vm-sans);
  font-size:       19px;
  font-weight:     900;
  color:           #fff;
  letter-spacing:  -0.05em;
  flex-shrink:     0;
  user-select:     none;
}

.vmpd__strava-row {
  display:     flex;
  align-items: flex-start;
  gap:         20px;
  margin-bottom: 20px;
}

.vmpd__strava-info-heading {
  font-size:      15px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-ink);
  margin:         0 0 6px;
}

.vmpd__strava-soon {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background:     rgba(20,22,15,0.08);
  color:          var(--vm-sage);
  padding:        2px 8px;
  margin-bottom:  10px;
}

.vmpd__strava-desc {
  font-size:   13px;
  line-height: 1.65;
  color:       var(--vm-sage);
  margin:      0;
}

.vmpd__strava-btn-disabled {
  display:        block;
  text-align:     center;
  background:     rgba(252,76,2,0.08);
  color:          rgba(252,76,2,0.4);
  border:         var(--vm-stroke) solid rgba(252,76,2,0.2);
  font-family:    var(--vm-sans);
  font-size:      12px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding:        11px 16px;
  cursor:         not-allowed;
  margin-top:     20px;
}

/* Account panel */
.vmpd__account-links {
  list-style: none;
  padding:    0;
  margin:     0;
}

.vmpd__account-link-item {
  border-bottom: 1px solid rgba(61,74,47,0.12);
}
.vmpd__account-link-item:last-child { border-bottom: none; }

.vmpd__account-link {
  display:         flex;
  align-items:     center;
  gap:             12px;
  padding:         14px 4px;
  text-decoration: none;
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.08em;
  color:           var(--vm-ink);
  transition:      color var(--vm-dur) ease;
}
.vmpd__account-link:hover { color: var(--vm-olive); }
.vmpd__account-link svg   { color: var(--vm-sage); flex-shrink: 0; transition: color var(--vm-dur) ease; }
.vmpd__account-link:hover svg { color: var(--vm-olive); }
.vmpd__account-link-arr {
  margin-left: auto;
  color:       var(--vm-sage);
  font-size:   16px;
  line-height: 1;
}

/* ── STRAVA CONNECTED STATE ──────────────────────────────────────────────── */

.vmpd__strava-athlete {
  display:     flex;
  align-items: center;
  gap:         16px;
  margin-bottom: 20px;
}
.vmpd__strava-athlete-img {
  width:        48px;
  height:       48px;
  border-radius: 50%;
  object-fit:   cover;
  flex-shrink:  0;
  background:   var(--vm-sage);
}
.vmpd__strava-athlete-name {
  font-size:      14px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-ink);
  margin:         0 0 3px;
  line-height:    1.2;
}
.vmpd__strava-connected-meta {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color:          #FC4C02;
}
.vmpd__strava-stats {
  display:       grid;
  grid-template-columns: repeat(2, 1fr);
  border:        var(--vm-stroke) solid rgba(61,74,47,0.2);
  margin-bottom: 16px;
}
.vmpd__strava-stat-cell {
  padding:       11px 14px;
  border-right:  var(--vm-stroke) solid rgba(61,74,47,0.2);
  border-bottom: var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__strava-stat-cell:nth-child(2n) { border-right: none; }
.vmpd__strava-stat-cell:nth-last-child(-n+2) { border-bottom: none; }
.vmpd__strava-stat-val {
  font-family: var(--vm-mono);
  font-size:   17px;
  font-weight: 400;
  color:       #FC4C02;
  display:     block;
  line-height: 1;
}
.vmpd__strava-stat-lbl {
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  display:        block;
  margin-top:     4px;
}
.vmpd__strava-type-badge {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  background:     rgba(252,76,2,0.1);
  color:          #FC4C02;
  padding:        3px 10px;
  margin-bottom:  16px;
}
.vmpd__strava-bikes {
  margin-bottom: 18px;
}
.vmpd__strava-bikes-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  8px;
}
.vmpd__strava-bike-row {
  display:       flex;
  justify-content: space-between;
  font-size:     13px;
  font-weight:   600;
  color:         var(--vm-ink);
  padding:       6px 0;
  border-bottom: 1px solid rgba(61,74,47,0.08);
}
.vmpd__strava-bike-row:last-child { border-bottom: none; }
.vmpd__strava-bike-km {
  font-family: var(--vm-mono);
  font-size:   11px;
  color:       var(--vm-sage);
}
.vmpd__strava-reconnect {
  font-family:     var(--vm-mono);
  font-size:       10px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  text-decoration: underline;
  text-underline-offset: 2px;
