.vmpd__comp-bar-fill--yellow { background: #E4A83B; }
.vmpd__comp-bar-fill--red    { background: #D9462A; }

.vmpd__comp-sub {
  display:     flex;
  align-items: center;
  gap:         10px;
  flex-wrap:   wrap;
  margin-top:  2px;
}
