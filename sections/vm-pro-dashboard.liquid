  <script>
  (function () {

    /* ── BIKE HEALTH PANEL ──────────────────────────────────────────────────
       Lädt Verschleißstatus via GET /apps/vm-pro/bike/health.
       Zeigt Ampelsystem (grün/gelb/rot) für alle Komponenten + Consumables.
       Reset-Funktion markiert Komponente als "gerade erneuert".
    ─────────────────────────────────────────────────────────────────────── */

    var healthBody  = document.getElementById('vmpd-health-body');
    var healthAlert = document.getElementById('vmpd-health-alert');
    var healthChip  = document.getElementById('vmpd-health-chip');

    var wizardState = { step: 1, bikeKm: null, chainKmSince: null, cassetteBrakepadsKmSince: null, cablesTiresChainringsKmSince: null };

    /* ── Kategorie (Road / Gravel) ──────────────────────────────────────────
       Ein Pro-Kunde kann je ein Road- und ein Gravel-Rad haben. Der Umschalter
       steuert, welches Rad Gesundheit + Bike-Panel anzeigen. Strava zieht die
       Verschleißdaten pro Kategorie getrennt (Server: ?category=road|gravel). */
    var vmNote = null;
    try { vmNote = typeof window.__vmProNote === 'string' ? JSON.parse(window.__vmProNote) : window.__vmProNote; } catch (e) {}
    var vmBikes = (vmNote && vmNote.vm_bikes) ? vmNote.vm_bikes : {};
    if (!vmBikes.road && !vmBikes.gravel && vmNote && vmNote.vm_bike) {
      vmBikes[(vmNote.vm_bike.category === 'gravel') ? 'gravel' : 'road'] = vmNote.vm_bike;
    }
    var availCats  = ['road', 'gravel'].filter(function (c) { return vmBikes[c] && vmBikes[c].collectionTag; });
    var currentCat = availCats.length ? availCats[0] : 'road';
    var CAT_LABEL  = { road: 'Road', gravel: 'Gravel' };
    var catToggleEl = document.getElementById('vmpd-health-cat');

    function buildCatToggle() {
      if (!catToggleEl) return;
      if (availCats.length < 2) { catToggleEl.style.display = 'none'; return; }
      catToggleEl.style.display = 'inline-flex';
      catToggleEl.innerHTML = availCats.map(function (c) {
        var active = c === currentCat;
        return '<button type="button" role="tab" data-cat="' + c + '" aria-selected="' + active + '" '
          + 'style="font-family:var(--vm-mono);font-size:10px;font-weight:700;text-transform:uppercase;'
          + 'letter-spacing:0.1em;padding:4px 11px;border:1.5px solid var(--vm-ink);cursor:pointer;line-height:1;'
          + 'background:' + (active ? 'var(--vm-ink)' : 'transparent') + ';'
          + 'color:' + (active ? 'var(--vm-bone)' : 'var(--vm-ink)') + '">' + CAT_LABEL[c] + '</button>';
      }).join('');
      catToggleEl.querySelectorAll('button').forEach(function (b) {
        b.addEventListener('click', function () { setCat(b.getAttribute('data-cat')); });
      });
    }

    function setCat(cat) {
      if (cat === currentCat) return;
      currentCat = cat;
      buildCatToggle();
      if (window.__vmBikePanelRender) window.__vmBikePanelRender(cat);
      loadHealth();
    }

    var STATUS_MSG = {
      green:  'Alles in Ordnung',
      yellow: 'Prüfung empfohlen',
      red:    'Handlungsbedarf',
    };

    function escH(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function fmtNum(n) {
      return n != null ? Number(n).toLocaleString('de-DE') : '—';
    }

    function lamp(status, size) {
      size = size || 10;
      return '<span class="vmpd__health-lamp vmpd__health-lamp--' + status + '"'
           + ' style="width:' + size + 'px;height:' + size + 'px" aria-hidden="true"></span>';
    }

    function bar(pct, status) {
      return '<div class="vmpd__comp-bar" role="progressbar" aria-valuenow="' + pct
           + '" aria-valuemin="0" aria-valuemax="100">'
           + '<div class="vmpd__comp-bar-fill vmpd__comp-bar-fill--' + status + '"'
           + ' style="width:' + Math.min(100, pct) + '%"></div></div>';
    }

    function compRow(comp) {
      var remText   = '';
      var sinceText = '';
      var resetDate = comp.reset_at ? '(zuletzt ' + comp.reset_at + ')' : '';

      /* Buy button — nur bei Warnung oder Kritisch */
      var buyBtn = comp.status !== 'green'
        ? '<a class="vmpd__comp-buy" href="/collections/all?filter.p.tag=vm-wartung-' + escH(comp.id)
          + '" aria-label="' + escH(comp.name) + ' kaufen">Kaufen →</a>'
        : '';

      /* Percentage color class */
      var pctClass = comp.status !== 'green' ? ' vmpd__comp-pct--' + comp.status : '';

      return '<div class="vmpd__comp-row">'
           +   '<span class="vmpd__comp-dot vmpd__comp-dot--' + comp.status + '" aria-hidden="true"></span>'
           +   '<div class="vmpd__comp-main">'
           +     '<div class="vmpd__comp-header">'
           +       '<span class="vmpd__comp-name">' + escH(comp.name) + '</span>'
           +       '<span class="vmpd__comp-pct' + pctClass + '">' + comp.wear_pct + '%</span>'
           +     '</div>'
           +     bar(comp.wear_pct, comp.status)
           +     '<div class="vmpd__comp-sub">'
           +       (resetDate ? '<span class="vmpd__comp-remaining">' + resetDate + '</span>' : '')
           +       '<button class="vmpd__comp-reset-btn" data-comp-id="' + escH(comp.id) + '" type="button">'
           +         'Als erneuert markieren</button>'
           +     '</div>'
           +     (comp.tip && comp.status !== 'green'
                   ? '<p class="vmpd__comp-tip">' + escH(comp.tip) + '</p>'
                   : '')
           +   '</div>'
           +   '<div class="vmpd__comp-actions">' + buyBtn + '</div>'
           + '</div>';
    }

    function renderHealth(data) {
      /* Alert-Leiste */
      if (healthAlert) {
        if (data.alerts && data.alerts.length) {
          var alertColor  = data.overall_status === 'red' ? 'var(--vm-signal)' : '#E4A83B';
          var alertWarn   = data.overall_status !== 'red' ? ' vmpd__alert-bar--warn' : '';
          var alertItems  = data.alerts.map(function(a) {
            return '<li class="vmpd__alert-item vmpd__alert-item--' + a.level + '">' + escH(a.message) + '</li>';
          }).join('');
          healthAlert.innerHTML =
            '<div class="vmpd__alert-bar' + alertWarn + '">'
            + '<svg class="vmpd__alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"'
            +   ' stroke="' + alertColor + '" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"'
            +   ' aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>'
            +   '<line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>'
            + '<ul class="vmpd__alert-list">' + alertItems + '</ul>'
            + '</div>';
          healthAlert.style.marginBottom = '0';
          healthAlert.style.display = 'block';
        } else {
          healthAlert.style.display = 'none';
        }
      }

      /* Panel-Header-Chip mit Gesamt-Status */
      if (healthChip) {
        var chipColor = data.overall_status === 'red'   ? '#D9462A'
                      : data.overall_status === 'yellow' ? '#C88B20'
                      : '#5CB85C';
        healthChip.innerHTML = lamp(data.overall_status, 8) + '<span>' + STATUS_MSG[data.overall_status] + '</span>';
        healthChip.style.color   = chipColor;
        healthChip.style.display = 'inline-flex';
      }

      /* Gesamt-Statuszeile */
      var cond = data.conditions || {};

      var odoKm = (data.bike_total_km != null) ? data.bike_total_km : data.odometer_km;
      var html = '<div class="vmpd__health-statusbar">'
               +   lamp(data.overall_status, 12)
               +   '<span class="vmpd__health-status-label">Gesamt </span>'
               +   '<span class="vmpd__health-status-val">' + STATUS_MSG[data.overall_status] + '</span>'
               +   '<span class="vmpd__health-odo">' + fmtNum(odoKm) + ' km gesamt</span>'
               + '</div>';

      /* Verschleißteile */
      var wear = (data.components || []).filter(function(c) { return !c.is_consumable; });
      wear.sort(function(a, b) { return b.wear_pct - a.wear_pct; });
      html += '<div class="vmpd__comp-section">'
            + '<div class="vmpd__comp-section-hd">Verschleißteile</div>';
      wear.forEach(function(c) { html += compRow(c); });
      html += '</div>';

      /* Verbrauchsmittel */
      var cons = (data.components || []).filter(function(c) { return c.is_consumable; });
      cons.sort(function(a, b) { return b.wear_pct - a.wear_pct; });
      html += '<div class="vmpd__comp-section">'
            + '<div class="vmpd__comp-section-hd">Verbrauchsmittel</div>';
      cons.forEach(function(c) { html += compRow(c); });
      html += '</div>';


      healthBody.innerHTML = html;

      /* Reset-Buttons verknüpfen */
      healthBody.querySelectorAll('.vmpd__comp-reset-btn').forEach(function(btn) {
        btn.addEventListener('click', function() { resetComp(btn.getAttribute('data-comp-id'), btn); });
      });
    }

    function renderHealthError(error) {
      if (healthChip) healthChip.style.display = 'none';
      var msg = error === 'strava_not_connected'
        ? 'Verbinde deinen Strava-Account, um den Bike-Verschleißstatus zu sehen.'
        : 'Statusdaten konnten nicht geladen werden. Bitte Seite neu laden.';
      healthBody.innerHTML = '<div class="vmpd__health-no-strava">' + msg + '</div>';
    }

    function resetComp(compId, btn) {
      var prev = btn.textContent;
      btn.textContent   = 'Wird gespeichert…';
      btn.style.pointerEvents = 'none';
      fetch('/apps/vm-pro/bike/health/reset?category=' + currentCat, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body:    JSON.stringify({ component_id: compId }),
      })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.ok) { loadHealth(); }
        else { btn.textContent = 'Fehler — neu laden'; btn.style.pointerEvents = ''; }
      })
      .catch(function() { btn.textContent = prev; btn.style.pointerEvents = ''; });
    }

    function loadHealth() {
      healthBody.innerHTML = '<div class="vmpd__health-loading">Lade Statusdaten…</div>';
      fetch('/apps/vm-pro/bike/health?category=' + currentCat, { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.ok) {
            if (d.needs_setup) { showWizard(); }
            else { renderHealth(d); }
          } else {
            renderHealthError(d.error);
          }
        })
        .catch(function() { renderHealthError('connection_error'); });
    }

    /* ── SETUP WIZARD ─────────────────────────────────────────────────────── */

    function showWizard() {
      if (healthChip) healthChip.style.display = 'none';
      if (healthAlert) healthAlert.style.display = 'none';
      wizardState = { step: 1, bikeKm: null, chainKmSince: null, cassetteBrakepadsKmSince: null, cablesTiresChainringsKmSince: null };
      healthBody.innerHTML = buildWizardStep(1);
      bindWizardEvents();
    }

    function buildWizardStep(step) {
      var prog = '';
      for (var i = 1; i <= 4; i++) {
        var cls = i < step ? '--done' : i === step ? '--active' : '';
        prog += '<div class="vmpd__wizard-step-dot' + (cls ? ' vmpd__wizard-step-dot' + cls : '') + '"></div>';
      }

      var inner = '';
      if (step === 1) {
        inner  = '<span class="vmpd__wizard-step-label">Schritt 1 von 4</span>';
        inner += '<h3 class="vmpd__wizard-question">Wie viele Kilometer hat dein Rad insgesamt?</h3>';
        inner += '<div class="vmpd__wizard-km-wrap">'
               + '<input class="vmpd__wizard-km-input" id="wz-km" type="number" min="0" max="999999" placeholder="z. B.&nbsp;3500"'
               + (wizardState.bikeKm != null ? ' value="' + wizardState.bikeKm + '"' : '') + '>'
               + '<span class="vmpd__wizard-km-unit">km</span>'
               + '</div>'
               + '<p class="vmpd__wizard-hint">Odometer deines Rades oder eine Schätzung. Hilft uns, den Verschleiß präzise zu berechnen.</p>';
      } else {
        var configs = [null,
          null,
          { lbl: 'Schritt 2 von 4', q: 'Wann hast du deine Kette zuletzt gewechselt?', name: 'wz-chain', sel: wizardState.chainKmSince,
            opts: [
              { val: 250,  main: 'Kürzlich',         sub: 'Weniger als 500 km' },
              { val: 1000, main: 'Vor 500– 1.500 km', sub: 'Mäßige Nutzung' },
              { val: 2000, main: 'Vor 1.500–2.500 km', sub: 'Bald fällig' },
              { val: 3000, main: 'Nie / Unbekannt',   sub: 'Wir nehmen vorsichtshalber Verschleiß an' },
            ]
          },
          { lbl: 'Schritt 3 von 4', q: 'Wann hast du Kassette und Bremsbelege zuletzt gewechselt?', name: 'wz-cass', sel: wizardState.cassetteBrakepadsKmSince,
            opts: [
              { val: 500,  main: 'Kürzlich',          sub: 'Weniger als 1.000 km' },
              { val: 2000, main: 'Vor 1.000–3.000 km', sub: 'Normale Nutzung' },
              { val: 4500, main: 'Vor 3.000–6.000 km', sub: 'Prüfung empfohlen' },
              { val: 8500, main: 'Nie / Unbekannt',    sub: 'Wir nehmen vorsichtshalber Verschleiß an' },
            ]
          },
          { lbl: 'Schritt 4 von 4', q: 'Wann hast du Züge, Reifen und Kettensterne zuletzt gewechselt?', name: 'wz-cables', sel: wizardState.cablesTiresChainringsKmSince,
            opts: [
              { val: 1000,  main: 'Kürzlich',            sub: 'Weniger als 2.000 km' },
              { val: 3500,  main: 'Vor 2.000–5.000 km', sub: 'Normale Nutzung' },
              { val: 7500,  main: 'Vor 5.000–10.000 km', sub: 'Auf dem Radar behalten' },
              { val: 12000, main: 'Nie / Unbekannt',      sub: 'Wir nehmen vorsichtshalber Verschleiß an' },
            ]
          }
        ];
        var c = configs[step];
        inner = '<span class="vmpd__wizard-step-label">' + c.lbl + '</span>'
              + '<h3 class="vmpd__wizard-question">' + c.q + '</h3>'
              + '<div class="vmpd__wizard-options">';
        c.opts.forEach(function(opt) {
          var chk = c.sel === opt.val ? ' checked' : '';
          inner += '<label class="vmpd__wizard-option">'
                 + '<input type="radio" name="' + c.name + '" value="' + opt.val + '"' + chk + '>'
                 + '<span class="vmpd__wizard-option-label">'
                 + '<span class="vmpd__wizard-option-main">' + escH(opt.main) + '</span>'
                 + '<span class="vmpd__wizard-option-sub">'  + escH(opt.sub)  + '</span>'
                 + '</span></label>';
        });
        inner += '</div>';
      }

      var backBtn = step > 1
        ? '<button class="vmpd__wizard-back" id="wz-back" type="button">← Zurück</button>'
        : '<span></span>';
      var nextLbl = step === 4 ? 'Analyse starten →' : 'Weiter →';

      return '<div class="vmpd__wizard">'
           + '<div class="vmpd__wizard-progress">' + prog + '</div>'
           + inner
           + '<div class="vmpd__wizard-nav">' + backBtn
           + '<button class="vmpd__wizard-next" id="wz-next" type="button" disabled>' + nextLbl + '</button>'
           + '</div></div>';
    }

    function bindWizardEvents() {
      var nextBtn = document.getElementById('wz-next');
      var backBtn = document.getElementById('wz-back');

      if (backBtn) {
        backBtn.addEventListener('click', function() {
          wizardState.step--;
          healthBody.innerHTML = buildWizardStep(wizardState.step);
          bindWizardEvents();
        });
      }

      function refreshNext() {
        if (nextBtn) nextBtn.disabled = !validateStep(wizardState.step);
      }

      var inputs = healthBody.querySelectorAll('input');
      inputs.forEach(function(inp) {
        inp.addEventListener('change', refreshNext);
        inp.addEventListener('input',  refreshNext);
      });

      if (nextBtn) {
        refreshNext();
        nextBtn.addEventListener('click', function() {
          if (!validateStep(wizardState.step)) return;
          saveStep(wizardState.step);
          if (wizardState.step === 4) {
            submitWizard();
          } else {
            wizardState.step++;
            healthBody.innerHTML = buildWizardStep(wizardState.step);
            bindWizardEvents();
          }
        });
      }
    }

    function validateStep(step) {
      if (step === 1) {
        var inp = document.getElementById('wz-km');
        if (!inp || inp.value === '') return false;
        var v = parseInt(inp.value, 10);
        return !isNaN(v) && v >= 0;
      }
      var name = step === 2 ? 'wz-chain' : step === 3 ? 'wz-cass' : 'wz-cables';
      return !!healthBody.querySelector('input[name="' + name + '"]:checked');
    }

    function saveStep(step) {
      if (step === 1) {
        var inp = document.getElementById('wz-km');
        wizardState.bikeKm = inp ? (parseInt(inp.value, 10) || 0) : 0;
      } else {
        var name = step === 2 ? 'wz-chain' : step === 3 ? 'wz-cass' : 'wz-cables';
        var chk  = healthBody.querySelector('input[name="' + name + '"]:checked');
        var val  = chk ? parseInt(chk.value, 10) : 0;
        if (step === 2) wizardState.chainKmSince = val;
        else if (step === 3) wizardState.cassetteBrakepadsKmSince = val;
        else wizardState.cablesTiresChainringsKmSince = val;
      }
    }

    function submitWizard() {
      healthBody.innerHTML = '<div class="vmpd__health-loading">Kalibrierung wird gespeichert…</div>';
      fetch('/apps/vm-pro/bike/setup?category=' + currentCat, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body:    JSON.stringify({
          bikeKm:                       wizardState.bikeKm,
          chainKmSince:                 wizardState.chainKmSince,
          cassetteBrakepadsKmSince:     wizardState.cassetteBrakepadsKmSince,
          cablesTiresChainringsKmSince: wizardState.cablesTiresChainringsKmSince,
        }),
      })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.ok) { renderHealth(d); }
        else { renderHealthError(d.error || 'setup_failed'); }
      })
      .catch(function() { renderHealthError('connection_error'); });
    }

    buildCatToggle();
    loadHealth();

    /* ─────────────────────────────────────────────────────────────────────── */

    var SEARCH_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
    var BIKE_SVG   = '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--vm-sage);opacity:.45"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h3.5"/><path d="M5.5 14L9 10"/></svg>';

    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function deHyphen(s) {
      if (!s) return '';
      return s.split('-').map(function(w) {
        return w ? w.charAt(0).toUpperCase() + w.slice(1) : '';
      }).join(' ');
    }

    /* ── Parse customer.note ───────────────────────────────────────────────── */
    var noteData = null;
    try {
      noteData = typeof window.__vmProNote === 'string'
        ? JSON.parse(window.__vmProNote)
        : window.__vmProNote;
    } catch (e) {}

    /* Clean ?strava= URL param after OAuth redirect */
    var stravaDenied = false;
    try {
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('strava')) {
        stravaDenied = urlParams.get('strava') === 'denied';
        history.replaceState({}, '', window.location.pathname);
      }
    } catch (e) {}

    /* Alte browser-weite Bruecke entfernen (war accountuebergreifend - Datenleck). */
    try { localStorage.removeItem('vm_pro_saved_bike'); } catch (e) {}

    /* BIKE PANEL - pro Account, Live-Abruf via App Proxy */
    var bikeBody = document.getElementById('vmpd-bike-body');
    if (bikeBody) {
      var renderBike = function (bike) {
        var displayBrand   = bike.brandName   || bike.brand   || '';
        var displayModel   = bike.modelName   || deHyphen(bike.model)   || '';
        var displayVariant = bike.variantName || deHyphen(bike.variant) || '';

        var specs = '';
        if (displayVariant)    specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Variante</span><span class="vmpd__bike-spec-value">' + esc(displayVariant) + '</span></div>';
        if (bike.schaltgruppe) specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Schaltgruppe</span><span class="vmpd__bike-spec-value">' + esc(bike.schaltgruppe) + '</span></div>';
        if (bike.modelljahre)  specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Modelljahre</span><span class="vmpd__bike-spec-value">' + esc(bike.modelljahre) + '</span></div>';

        bikeBody.innerHTML =
          (displayBrand ? '<p class="vmpd__bike-brand">' + esc(displayBrand) + '</p>' : '') +
          (displayModel ? '<p class="vmpd__bike-model">' + esc(displayModel) + '</p>' : '') +
          (specs ? '<div class="vmpd__bike-specs">' + specs + '</div>' : '') +
          '<a class="vmpd__parts-btn" href="/collections/all?filter.p.tag=' + encodeURIComponent(bike.collectionTag) + '">' +
          SEARCH_SVG + ' Passende Teile finden →</a>';
      };

      var CAT_LABEL = { road: 'Road', gravel: 'Gravel' };
      var renderBikeEmpty = function (cat) {
        var what = cat ? (CAT_LABEL[cat] + '-Rad') : 'Rad';
        bikeBody.innerHTML =
          '<div class="vmpd__empty" role="status">' + BIKE_SVG +
          '<p class="vmpd__empty-label">Noch kein ' + what + ' gespeichert. Wähle dein Fahrrad im Konfigurator aus.</p>' +
          '<a class="vmpd__selector-link" href="/">Rad konfigurieren →</a></div>';
      };

      /* Räder pro Kategorie aus der Note (Legacy-Einzelrad → road) */
      var bikesByCat = (noteData && noteData.vm_bikes) ? noteData.vm_bikes : {};
      if (!bikesByCat.road && !bikesByCat.gravel && noteData && noteData.vm_bike) {
        bikesByCat[(noteData.vm_bike.category === 'gravel') ? 'gravel' : 'road'] = noteData.vm_bike;
      }
      var defaultCat = (bikesByCat.road && bikesByCat.road.collectionTag) ? 'road'
                     : (bikesByCat.gravel && bikesByCat.gravel.collectionTag) ? 'gravel' : 'road';

      /* Vom Kategorie-Umschalter (Gesundheits-Panel) aufgerufen */
      window.__vmBikePanelRender = function (cat) {
        var bike = bikesByCat[cat];
        if (bike && bike.collectionTag) renderBike(bike);
        else renderBikeEmpty(cat);
      };

      var haveAny = (bikesByCat.road && bikesByCat.road.collectionTag) ||
                    (bikesByCat.gravel && bikesByCat.gravel.collectionTag);
      if (haveAny) {
        window.__vmBikePanelRender(defaultCat);
      } else {
        bikeBody.innerHTML = '<div class="vmpd__strava-pending">Lade dein Rad…</div>';
        fetch('/apps/vm-pro/bike', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var b = (d && d.bikes) ? d.bikes : {};
            if (d && d.bike && !b.road && !b.gravel) {
              b[(d.bike.category === 'gravel') ? 'gravel' : 'road'] = d.bike;
            }
            bikesByCat = b;
            var dc = (b.road && b.road.collectionTag) ? 'road'
                   : (b.gravel && b.gravel.collectionTag) ? 'gravel' : 'road';
            window.__vmBikePanelRender(dc);
          })
          .catch(function () { renderBikeEmpty(); });
      }
    }

    /* STRAVA PANEL - Live-Daten via App Proxy */
    var stravaBody = document.getElementById('vmpd-strava-body');
    if (!stravaBody) return;

    var RIDE_LABELS = {
      'Ride': 'Rennrad', 'MountainBikeRide': 'Mountainbike',
      'GravelRide': 'Gravel', 'VirtualRide': 'Indoor', 'EBikeRide': 'E-Bike'
    };

    function fmtKm(km) {
      if (km == null) return '\u2014';
      return km.toLocaleString('de-DE') + ' km';
    }

    function renderConnect(msg) {
      stravaBody.innerHTML =
        '<div class="vmpd__strava-connect-wrap">' +
        '<div class="vmpd__strava-row"><div class="vmpd__strava-logo" aria-hidden="true">S</div>' +
        '<div><h3 class="vmpd__strava-info-heading">Strava verkn\u00fcpfen</h3>' +
        '<p class="vmpd__strava-desc">' + (msg || 'Verbinde deinen Strava-Account, um Aktivit\u00e4tsdaten zu sammeln und Produkt-Empfehlungen zu personalisieren.') + '</p></div></div>' +
        '<a class="vmpd__strava-connect-btn" href="/apps/vm-pro/strava/connect">Mit Strava verbinden \u2192</a></div>';
    }

    function renderConnected(s) {
      var a = s.athlete || {};
      var p = s.profile || {};

      var isDefaultAvatar = !a.profile || a.profile.indexOf('large.jpg') !== -1;
      var avatarHtml = isDefaultAvatar
        ? '<div class="vmpd__strava-logo vmpd__strava-athlete-img" aria-hidden="true">S</div>'
        : '<img class="vmpd__strava-athlete-img" src="' + esc(a.profile) + '" alt="" loading="lazy">';

      var statsHtml =
        '<div class="vmpd__strava-stats">' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + fmtKm(p.ytd_distance_km) + '</span><span class="vmpd__strava-stat-lbl">Dieses Jahr</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + (p.ytd_rides != null ? p.ytd_rides : '\u2014') + '</span><span class="vmpd__strava-stat-lbl">Fahrten (Jahr)</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + (p.avg_ride_distance_km ? p.avg_ride_distance_km + ' km' : '\u2014') + '</span><span class="vmpd__strava-stat-lbl">\u00d8 Distanz</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + fmtKm(p.all_time_distance_km) + '</span><span class="vmpd__strava-stat-lbl">Gesamt</span></div>' +
        '</div>';

      var typeHtml = p.dominant_ride_type
        ? '<span class="vmpd__strava-type-badge">Fahrstil: ' + esc(RIDE_LABELS[p.dominant_ride_type] || p.dominant_ride_type) + '</span>'
        : '';

      var bikesHtml = '';
      if (a.bikes && a.bikes.length) {
        bikesHtml = '<div class="vmpd__strava-bikes"><span class="vmpd__strava-bikes-label">Fahrr\u00e4der auf Strava</span>';
        a.bikes.forEach(function(b) {
          bikesHtml += '<div class="vmpd__strava-bike-row"><span>' + esc(b.name) + '</span>' +
            (b.distance_km ? '<span class="vmpd__strava-bike-km">' + b.distance_km.toLocaleString('de-DE') + ' km</span>' : '') + '</div>';
        });
        bikesHtml += '</div>';
      }

      var connDate = '';
      try { connDate = new Date(s.connected_at).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }); } catch(e) {}

      stravaBody.innerHTML =
        '<div class="vmpd__strava-athlete">' + avatarHtml +
        '<div><p class="vmpd__strava-athlete-name">' + esc(a.firstname) + ' ' + esc(a.lastname) + '</p>' +
        '<span class="vmpd__strava-connected-meta">Verbunden \u00b7 ' + connDate + '</span></div></div>' +
        statsHtml + typeHtml + bikesHtml +
        '<span class="vmpd__strava-reconnect" id="vm-strava-refresh" role="button" tabindex="0">Daten aktualisieren</span>' +
        '<button class="vmpd__strava-logout" id="vm-strava-logout" type="button">Bei Strava ausloggen</button>';

      var refreshBtn = document.getElementById('vm-strava-refresh');
      if (refreshBtn) refreshBtn.addEventListener('click', doRefresh);
      var logoutBtn = document.getElementById('vm-strava-logout');
      if (logoutBtn) logoutBtn.addEventListener('click', doDisconnect);
    }

    /* Strava-Verbindung trennen: Zugriff bei Strava widerrufen + gespeichertes
       Profil entfernen, damit ein neues Strava-Profil verbunden werden kann. */
    function doDisconnect() {
      if (!window.confirm('Strava-Verbindung trennen? Dein gespeichertes Strava-Profil wird entfernt. Du kannst danach ein anderes Strava-Profil verbinden.')) return;
      var btn = document.getElementById('vm-strava-logout');
      if (btn) { btn.textContent = 'Wird getrennt…'; btn.style.pointerEvents = 'none'; }
      fetch('/apps/vm-pro/strava/disconnect', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function() {
          renderConnect('Strava wurde getrennt. Du kannst jetzt ein neues Strava-Profil verbinden. Hinweis: Bist du noch bei strava.com angemeldet, melde dich dort ab, um einen anderen Account zu nutzen.');
        })
        .catch(function() {
          if (btn) { btn.textContent = 'Trennen fehlgeschlagen'; btn.style.pointerEvents = ''; }
        });
    }

    /* Daten via refresh_token neu laden - ohne erneuten Strava-Login. */
    function doRefresh() {
      var btn = document.getElementById('vm-strava-refresh');
      if (btn) { btn.textContent = 'Wird aktualisiert\u2026'; btn.style.pointerEvents = 'none'; }
      fetch('/apps/vm-pro/strava/refresh', { headers: { 'Accept': 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.connected && data.athlete) {
            renderConnected(data);
          } else if (btn) {
            btn.textContent = 'Aktualisierung fehlgeschlagen';
            btn.style.pointerEvents = '';
          }
        })
        .catch(function() {
          if (btn) { btn.textContent = 'Aktualisierung fehlgeschlagen'; btn.style.pointerEvents = ''; }
        });
    }

    stravaBody.innerHTML = '<div class="vmpd__strava-pending">Lade Strava-Daten\u2026</div>';

    fetch('/apps/vm-pro/strava/profile', { headers: { 'Accept': 'application/json' } })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data && data.connected && data.athlete) {
          renderConnected(data);
        } else {
          renderConnect(stravaDenied ? 'Verbindung abgelehnt. Du kannst es jederzeit erneut versuchen.' : null);
        }
      })
      .catch(function() { renderConnect(null); });

    /* ── Abo kündigen ──────────────────────────────────────────────────────── */
    var cancelTrigger = document.getElementById('vmpd-cancel-trigger');
    var cancelModal   = document.getElementById('vmpd-cancel-modal');
    var cancelConfirm = document.getElementById('vmpd-cancel-confirm');
    var cancelAbort   = document.getElementById('vmpd-cancel-abort');
    var cancelBg      = document.getElementById('vmpd-cancel-bg');

    function openCancelModal() {
      cancelModal.classList.add('vmpd__modal--open');
      document.body.style.overflow = 'hidden';
      setTimeout(function() { if (cancelConfirm) cancelConfirm.focus(); }, 50);
    }

    function closeCancelModal() {
      cancelModal.classList.remove('vmpd__modal--open');
      document.body.style.overflow = '';
      if (cancelTrigger) cancelTrigger.focus();
    }

    if (cancelTrigger) cancelTrigger.addEventListener('click', openCancelModal);
    if (cancelAbort)   cancelAbort.addEventListener('click', closeCancelModal);
    if (cancelBg)      cancelBg.addEventListener('click', closeCancelModal);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && cancelModal.classList.contains('vmpd__modal--open')) closeCancelModal();
    });

    if (cancelConfirm) {
      cancelConfirm.addEventListener('click', function() {
        cancelConfirm.textContent = 'Wird bearbeitet…';
        cancelConfirm.disabled    = true;
        fetch('/apps/vm-pro/cancel', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body:    JSON.stringify({ reason: 'user_requested' }),
        })
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.ok) {
            closeCancelModal();
            var zone = document.querySelector('.vmpd__cancel-zone');
            if (zone) {
              zone.innerHTML =
                '<div class="vmpd__cancel-done"><strong>Kündigung beantragt.</strong> '
                + 'Du hast bis zum Ende des aktuellen Abrechnungsmonats weiterhin vollen Zugang. '
                + 'Wir melden uns per E-Mail zur Bestätigung.</div>';
            }
          } else {
            cancelConfirm.textContent = 'Fehler — bitte erneut versuchen';
            cancelConfirm.disabled    = false;
          }
        })
        .catch(function() {
          cancelConfirm.textContent = 'Fehler — bitte erneut versuchen';
          cancelConfirm.disabled    = false;
        });
      });
    }

  })();
  </script>

{%- else -%}
  <div class="vmpd">
    <div class="vmpd__inner" style="padding-top: 64px;">
      <div class="vmpd__gate">
        <div class="vmpd__gate-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
