{%- comment -%} sections/vm-pro-dashboard.liquid — VM Pro Members Dashboard {%- endcomment -%}

<style>
/* ── VM Pro Dashboard ────────────────────────────────────────────────────── */
.vmpd {
  --vm-olive:      #3D4A2F;
  --vm-olive-deep: #2A331F;
  --vm-moss:       #5E7142;
  --vm-sage:       #9CA982;
  --vm-signal:     #C9E45B;
  --vm-ink:        #14160F;
  --vm-bone:       #F2F0E6;
  --vm-paper:      #FBFAF3;
  --vm-stroke:     1.5px;
  --vm-stroke-2:   2.5px;
  --vm-mono:       'Courier New', 'Lucida Console', monospace;
  --vm-sans:       'Helvetica Neue', Arial, sans-serif;
  --vm-dur:        220ms;
  --vm-ease:       cubic-bezier(0.2, 0.7, 0.2, 1);

  background:  var(--vm-bone);
  font-family: var(--vm-sans);
  color:       var(--vm-ink);
  min-height:  80vh;
  box-sizing:  border-box;
}
.vmpd *, .vmpd *::before, .vmpd *::after { box-sizing: inherit; }

.vmpd__inner {
  max-width: 1200px;
  margin:    0 auto;
  padding:   0 40px 96px;
}

/* ── AUTH STATES (not logged in / not pro) ──────────────────────────────── */

.vmpd__gate {
  display:        flex;
  flex-direction: column;
  align-items:    center;
  justify-content: center;
  min-height:     60vh;
  text-align:     center;
  padding:        64px 40px;
}

.vmpd__gate-icon {
  width:       56px;
  height:      56px;
  border:      var(--vm-stroke-2) solid var(--vm-ink);
  display:     flex;
  align-items: center;
  justify-content: center;
  margin:      0 auto 24px;
  color:       var(--vm-sage);
}

.vmpd__gate-heading {
  font-size:      clamp(20px, 3vw, 30px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  margin:         0 0 12px;
}

.vmpd__gate-text {
  font-size:   15px;
  line-height: 1.65;
  color:       var(--vm-sage);
  max-width:   440px;
  margin:      0 auto 32px;
}

.vmpd__gate-btn {
  display:         inline-block;
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  text-decoration: none;
  font-family:     var(--vm-sans);
  font-size:       14px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.04em;
  padding:         14px 32px;
  transition:      transform var(--vm-dur) var(--vm-ease),
                   box-shadow var(--vm-dur) var(--vm-ease);
}

@media (prefers-reduced-motion: no-preference) {
  .vmpd__gate-btn:hover {
    transform:  translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--vm-ink);
  }
}

.vmpd__gate-btn--secondary {
  background:      transparent;
  color:           var(--vm-sage);
  border:          var(--vm-stroke) solid rgba(61,74,47,0.3);
  margin-top:      12px;
}
.vmpd__gate-btn--secondary:hover {
  border-color: var(--vm-olive);
  color:        var(--vm-ink);
  box-shadow:   5px 5px 0 var(--vm-sage);
}

/* Upgrade wall — teaser tiles */
.vmpd__upgrade-features {
  display:               grid;
  grid-template-columns: repeat(3, 1fr);
  gap:                   16px;
  max-width:             680px;
  margin:                32px auto 40px;
  text-align:            left;
}

.vmpd__upgrade-feature {
  background:  var(--vm-paper);
  border:      var(--vm-stroke) solid rgba(61,74,47,0.25);
  padding:     20px 20px 16px;
  opacity:     0.55;
  filter:      blur(0px);
}

.vmpd__upgrade-feature-icon {
  color:       var(--vm-sage);
  margin-bottom: 12px;
}

.vmpd__upgrade-feature-name {
  font-size:      13px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color:          var(--vm-ink);
  margin:         0 0 4px;
}

.vmpd__upgrade-feature-text {
  font-size:   12px;
  color:       var(--vm-sage);
  line-height: 1.5;
  margin:      0;
}

/* ── DASHBOARD HEADER ───────────────────────────────────────────────────── */

.vmpd__header {
  background:    var(--vm-ink);
  margin:        0 -40px;
  padding:       40px 40px 36px;
  display:       flex;
  align-items:   flex-end;
  justify-content: space-between;
  gap:           24px;
  flex-wrap:     wrap;
  border-bottom: var(--vm-stroke-2) solid var(--vm-olive);
  margin-bottom: 0;
}

.vmpd__header-left { display: flex; flex-direction: column; gap: 10px; }

/* VM Pro wordmark — Tag Signal variant */
.vmpd__wordmark {
  display:     inline-flex;
  align-items: center;
  gap:         0;
  font-family: 'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:   clamp(28px, 4vw, 44px);
  letter-spacing: -0.045em;
  line-height: 1;
}

.vmpd__wordmark-velo  { font-weight: 400; color: var(--vm-bone); }
.vmpd__wordmark-match { font-weight: 700; color: var(--vm-bone); }
.vmpd__wordmark-tag {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  font-family:    'Helvetica Neue', Arial, sans-serif;
  font-size:      0.33em;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        0.25em 0.6em 0.2em;
  margin-left:    10px;
  line-height:    1.5;
  align-self:     center;
}

.vmpd__header-greeting {
  font-family:    var(--vm-mono);
  font-size:      13px;
  color:          var(--vm-sage);
  letter-spacing: 0.08em;
}

.vmpd__header-greeting strong {
  color:       var(--vm-bone);
  font-weight: 700;
}

.vmpd__header-right {
  display:     flex;
  align-items: flex-end;
  gap:         12px;
  flex-wrap:   wrap;
}

.vmpd__status-chip {
  display:        inline-flex;
  align-items:    center;
  gap:            7px;
  background:     rgba(201,228,91,0.12);
  border:         1px solid rgba(201,228,91,0.35);
  color:          var(--vm-signal);
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  padding:        5px 12px;
}

.vmpd__status-dot {
  width:         7px;
  height:        7px;
  border-radius: 50%;
  background:    var(--vm-signal);
  flex-shrink:   0;
}

.vmpd__header-logout {
  font-family:     var(--vm-mono);
  font-size:       11px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  text-decoration: none;
  opacity:         0.6;
  transition:      opacity var(--vm-dur) ease;
}
.vmpd__header-logout:hover { opacity: 1; color: var(--vm-bone); }

/* ── STATS BAR ──────────────────────────────────────────────────────────── */

.vmpd__stats {
  display:     grid;
  grid-template-columns: repeat(3, 1fr);
  background:  var(--vm-olive);
  border-bottom: var(--vm-stroke-2) solid var(--vm-signal);
  margin:      0 -40px 56px;
}

.vmpd__stat {
  padding:       24px 32px;
  border-right:  1px solid rgba(201,228,91,0.15);
}
.vmpd__stat:last-child { border-right: none; }

.vmpd__stat-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  8px;
}

.vmpd__stat-value {
  font-family:    var(--vm-mono);
  font-size:      22px;
  font-weight:    400;
  color:          var(--vm-signal);
  line-height:    1;
  display:        block;
}

.vmpd__stat-sub {
  font-size:   11px;
  color:       rgba(156,169,130,0.7);
  margin-top:  4px;
  display:     block;
  font-family: var(--vm-mono);
}

/* ── MAIN GRID ──────────────────────────────────────────────────────────── */

.vmpd__grid {
  display:               grid;
  grid-template-columns: 1fr 340px;
  gap:                   32px;
  align-items:           start;
}

/* ── PANEL (shared) ──────────────────────────────────────────────────────── */

.vmpd__panel {
  border:          var(--vm-stroke) solid var(--vm-ink);
  background:      var(--vm-paper);
  margin-bottom:   32px;
}
.vmpd__panel:last-child { margin-bottom: 0; }

.vmpd__panel-hd {
  display:       flex;
  align-items:   center;
  gap:           12px;
  padding:       18px 24px;
  border-bottom: var(--vm-stroke) solid var(--vm-ink);
  background:    var(--vm-bone);
}

.vmpd__panel-num {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  color:          var(--vm-sage);
  letter-spacing: 0.1em;
  flex-shrink:    0;
}

.vmpd__panel-title {
  font-size:      15px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color:          var(--vm-ink);
  margin:         0;
  flex:           1;
}

.vmpd__panel-action {
  font-family:     var(--vm-mono);
  font-size:       11px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-moss);
  text-decoration: none;
  opacity:         0.7;
  transition:      opacity var(--vm-dur) ease, color var(--vm-dur) ease;
  flex-shrink:     0;
}
.vmpd__panel-action:hover { opacity: 1; color: var(--vm-olive); }

.vmpd__panel-body { padding: 28px 24px; }

/* ── BIKE PANEL ──────────────────────────────────────────────────────────── */

.vmpd__bike-specs {
  display:               grid;
  grid-template-columns: repeat(2, 1fr);
  border:                var(--vm-stroke) solid rgba(61,74,47,0.2);
  margin-bottom:         24px;
}

.vmpd__bike-spec {
  padding:     16px 18px;
  border-right: var(--vm-stroke) solid rgba(61,74,47,0.2);
  border-bottom: var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__bike-spec:nth-child(2n)      { border-right: none; }
.vmpd__bike-spec:nth-last-child(-n+2) { border-bottom: none; }

.vmpd__bike-spec-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  5px;
}

.vmpd__bike-spec-value {
  font-size:   15px;
  font-weight: 700;
  color:       var(--vm-ink);
  line-height: 1.3;
}

.vmpd__bike-brand {
  font-size:      clamp(22px, 3vw, 32px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  color:          var(--vm-ink);
  margin:         0 0 4px;
  line-height:    1;
}

.vmpd__bike-model {
  font-size:   16px;
  font-weight: 700;
  color:       var(--vm-moss);
  margin:      0 0 20px;
  text-transform: uppercase;
  letter-spacing: -0.01em;
}

.vmpd__parts-btn {
  display:         inline-flex;
  align-items:     center;
  gap:             10px;
  background:      var(--vm-signal);
  color:           var(--vm-ink);
  text-decoration: none;
  font-family:     var(--vm-sans);
  font-size:       13px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.04em;
  padding:         13px 22px;
  transition:      transform var(--vm-dur) var(--vm-ease),
                   box-shadow var(--vm-dur) var(--vm-ease);
}
@media (prefers-reduced-motion: no-preference) {
  .vmpd__parts-btn:hover {
    transform:  translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--vm-olive);
  }
}

.vmpd__selector-link {
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.08em;
  color:           var(--vm-sage);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition:      color var(--vm-dur) ease;
}
.vmpd__selector-link:hover { color: var(--vm-ink); }

/* empty state */
.vmpd__empty {
  display:        flex;
  flex-direction: column;
  align-items:    flex-start;
  gap:            12px;
  padding:        8px 0;
}

.vmpd__empty-label {
  font-size:   15px;
  line-height: 1.65;
  color:       var(--vm-sage);
  margin:      0;
}

/* ── ORDERS PANEL ────────────────────────────────────────────────────────── */

.vmpd__orders-table {
  width:           100%;
  border-collapse: collapse;
  font-size:       13px;
}

.vmpd__orders-table th {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  text-align:     left;
  padding:        0 12px 12px 0;
  border-bottom:  var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__orders-table th:last-child { padding-right: 0; }

.vmpd__orders-table td {
  padding:       13px 12px 13px 0;
  border-bottom: 1px solid rgba(61,74,47,0.1);
  vertical-align: middle;
  color:         var(--vm-ink);
}
.vmpd__orders-table td:last-child { padding-right: 0; }

.vmpd__orders-table tr:last-child td { border-bottom: none; }

.vmpd__order-num {
  font-family:     var(--vm-mono);
  font-weight:     700;
  font-size:       13px;
  color:           var(--vm-olive);
  text-decoration: none;
}
.vmpd__order-num:hover { color: var(--vm-ink); text-decoration: underline; }

.vmpd__order-date {
  font-family: var(--vm-mono);
  font-size:   12px;
  color:       var(--vm-sage);
}

.vmpd__order-total {
  font-family:  var(--vm-mono);
  font-size:    14px;
  font-weight:  700;
  white-space:  nowrap;
}

.vmpd__order-badge {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding:        2px 7px;
  white-space:    nowrap;
}

.vmpd__order-badge--paid     { background: rgba(201,228,91,0.18); color: var(--vm-olive); }
.vmpd__order-badge--pending  { background: rgba(255,200,50,0.18); color: #8A6800; }
.vmpd__order-badge--refunded { background: rgba(217,79,58,0.12);  color: #9A3520; }

.vmpd__orders-empty {
  padding: 24px 0;
  font-size: 14px;
  color: var(--vm-sage);
}

/* ── SIDE PANELS ─────────────────────────────────────────────────────────── */

/* Strava panel */
.vmpd__strava-logo {
  width:           48px;
  height:          48px;
  border-radius:   50%;
  background:      #FC4C02;
  display:         flex;
  align-items:     center;
  justify-content: center;
  font-family:     var(--vm-sans);
  font-size:       19px;
  font-weight:     900;
  color:           #fff;
  letter-spacing:  -0.05em;
  flex-shrink:     0;
  user-select:     none;
}

.vmpd__strava-row {
  display:     flex;
  align-items: flex-start;
  gap:         20px;
  margin-bottom: 20px;
}

.vmpd__strava-info-heading {
  font-size:      15px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-ink);
  margin:         0 0 6px;
}

.vmpd__strava-soon {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background:     rgba(20,22,15,0.08);
  color:          var(--vm-sage);
  padding:        2px 8px;
  margin-bottom:  10px;
}

.vmpd__strava-desc {
  font-size:   13px;
  line-height: 1.65;
  color:       var(--vm-sage);
  margin:      0;
}

.vmpd__strava-btn-disabled {
  display:        block;
  text-align:     center;
  background:     rgba(252,76,2,0.08);
  color:          rgba(252,76,2,0.4);
  border:         var(--vm-stroke) solid rgba(252,76,2,0.2);
  font-family:    var(--vm-sans);
  font-size:      12px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding:        11px 16px;
  cursor:         not-allowed;
  margin-top:     20px;
}

/* Account panel */
.vmpd__account-links {
  list-style: none;
  padding:    0;
  margin:     0;
}

.vmpd__account-link-item {
  border-bottom: 1px solid rgba(61,74,47,0.12);
}
.vmpd__account-link-item:last-child { border-bottom: none; }

.vmpd__account-link {
  display:         flex;
  align-items:     center;
  gap:             12px;
  padding:         14px 4px;
  text-decoration: none;
  font-size:       13px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.08em;
  color:           var(--vm-ink);
  transition:      color var(--vm-dur) ease;
}
.vmpd__account-link:hover { color: var(--vm-olive); }
.vmpd__account-link svg   { color: var(--vm-sage); flex-shrink: 0; transition: color var(--vm-dur) ease; }
.vmpd__account-link:hover svg { color: var(--vm-olive); }
.vmpd__account-link-arr {
  margin-left: auto;
  color:       var(--vm-sage);
  font-size:   16px;
  line-height: 1;
}

/* ── STRAVA CONNECTED STATE ──────────────────────────────────────────────── */

.vmpd__strava-athlete {
  display:     flex;
  align-items: center;
  gap:         16px;
  margin-bottom: 20px;
}
.vmpd__strava-athlete-img {
  width:        48px;
  height:       48px;
  border-radius: 50%;
  object-fit:   cover;
  flex-shrink:  0;
  background:   var(--vm-sage);
}
.vmpd__strava-athlete-name {
  font-size:      14px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-ink);
  margin:         0 0 3px;
  line-height:    1.2;
}
.vmpd__strava-connected-meta {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color:          #FC4C02;
}
.vmpd__strava-stats {
  display:       grid;
  grid-template-columns: repeat(2, 1fr);
  border:        var(--vm-stroke) solid rgba(61,74,47,0.2);
  margin-bottom: 16px;
}
.vmpd__strava-stat-cell {
  padding:       11px 14px;
  border-right:  var(--vm-stroke) solid rgba(61,74,47,0.2);
  border-bottom: var(--vm-stroke) solid rgba(61,74,47,0.2);
}
.vmpd__strava-stat-cell:nth-child(2n) { border-right: none; }
.vmpd__strava-stat-cell:nth-last-child(-n+2) { border-bottom: none; }
.vmpd__strava-stat-val {
  font-family: var(--vm-mono);
  font-size:   17px;
  font-weight: 400;
  color:       #FC4C02;
  display:     block;
  line-height: 1;
}
.vmpd__strava-stat-lbl {
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  display:        block;
  margin-top:     4px;
}
.vmpd__strava-type-badge {
  display:        inline-block;
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  background:     rgba(252,76,2,0.1);
  color:          #FC4C02;
  padding:        3px 10px;
  margin-bottom:  16px;
}
.vmpd__strava-bikes {
  margin-bottom: 18px;
}
.vmpd__strava-bikes-label {
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color:          var(--vm-sage);
  display:        block;
  margin-bottom:  8px;
}
.vmpd__strava-bike-row {
  display:       flex;
  justify-content: space-between;
  font-size:     13px;
  font-weight:   600;
  color:         var(--vm-ink);
  padding:       6px 0;
  border-bottom: 1px solid rgba(61,74,47,0.08);
}
.vmpd__strava-bike-row:last-child { border-bottom: none; }
.vmpd__strava-bike-km {
  font-family: var(--vm-mono);
  font-size:   11px;
  color:       var(--vm-sage);
}
.vmpd__strava-reconnect {
  font-family:     var(--vm-mono);
  font-size:       10px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-sage);
  text-decoration: underline;
  text-underline-offset: 2px;
  display:         inline-block;
  margin-top:      14px;
  transition:      color var(--vm-dur) ease;
}
.vmpd__strava-reconnect:hover { color: var(--vm-ink); }

/* Connect (not yet linked) */
.vmpd__strava-connect-wrap { padding: 4px 0 8px; }
.vmpd__strava-connect-btn {
  display:         block;
  text-align:      center;
  text-decoration: none;
  background:      #FC4C02;
  color:           #fff;
  font-family:     var(--vm-sans);
  font-size:       13px;
  font-weight:     800;
  text-transform:  uppercase;
  letter-spacing:  0.06em;
  padding:         13px 20px;
  transition:      transform var(--vm-dur) var(--vm-ease),
                   box-shadow var(--vm-dur) var(--vm-ease);
  margin-top:      20px;
}
@media (prefers-reduced-motion: no-preference) {
  .vmpd__strava-connect-btn:hover {
    transform:  translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--vm-ink);
  }
}

/* Pending / loading state */
.vmpd__strava-pending {
  font-size:   14px;
  color:       var(--vm-sage);
  text-align:  center;
  padding:     24px 0 16px;
}
.vmpd__strava-pending-reload {
  display:         block;
  text-align:      center;
  font-family:     var(--vm-mono);
  font-size:       11px;
  font-weight:     700;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--vm-moss);
  text-decoration: underline;
  margin-top:      10px;
  cursor:          pointer;
}

/* ── RESPONSIVE ──────────────────────────────────────────────────────────── */

@media (max-width: 960px) {
  .vmpd__inner   { padding: 0 20px 64px; }
  .vmpd__header  { margin: 0 -20px; padding: 32px 20px 28px; }
  .vmpd__stats   { margin: 0 -20px 40px; }
  .vmpd__grid    { grid-template-columns: 1fr; }
  .vmpd__upgrade-features { grid-template-columns: 1fr; max-width: 340px; }
}

@media (max-width: 600px) {
  .vmpd__stats   { grid-template-columns: 1fr 1fr; }
  .vmpd__stat:last-child { grid-column: 1 / -1; border-right: none; border-top: 1px solid rgba(201,228,91,0.15); }
  .vmpd__bike-specs { grid-template-columns: 1fr; }
  .vmpd__bike-spec  { border-right: none !important; }
  .vmpd__bike-spec:nth-last-child(-n+2) { border-bottom: var(--vm-stroke) solid rgba(61,74,47,0.2) !important; }
  .vmpd__bike-spec:last-child { border-bottom: none !important; }
  .vmpd__wordmark { font-size: 26px; }
}
</style>

{%- comment -%} ── AUTH GATE ─────────────────────────────────────────────── {%- endcomment -%}

{%- if customer == nil -%}
  {%- comment -%} Not logged in → redirect to login with return URL {%- endcomment -%}
  <script>
    window.location.replace(
      '/account/login?return_url=' + encodeURIComponent(window.location.pathname)
    );
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/account/login">
  </noscript>
  <div class="vmpd">
    <div class="vmpd__inner">
      <div class="vmpd__gate">
        <div class="vmpd__gate-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </div>
        <h1 class="vmpd__gate-heading">Bitte einloggen</h1>
        <p class="vmpd__gate-text">Du wirst weitergeleitet…</p>
        <a class="vmpd__gate-btn" href="/account/login">Einloggen →</a>
      </div>
    </div>
  </div>

{%- elsif customer.tags contains 'vm-pro' -%}
  {%- comment -%} ── AUTHENTICATED VM PRO DASHBOARD ─────────────────────── {%- endcomment -%}

  <script>window.__vmProNote = {{ customer.note | json }};</script>
  <div class="vmpd">
    <div class="vmpd__inner">

      <!-- ── DASHBOARD HEADER ─────────────────────────────────────────── -->
      <header class="vmpd__header">
        <div class="vmpd__header-left">
          <h1 class="vmpd__wordmark" aria-label="velomatch Pro Dashboard">
            <span class="vmpd__wordmark-velo">velo</span><span class="vmpd__wordmark-match">match</span>
            <span class="vmpd__wordmark-tag" aria-hidden="true">PRO</span>
          </h1>
          <p class="vmpd__header-greeting">
            Hallo, <strong>{{ customer.first_name | default: customer.email }}</strong>
          </p>
        </div>
        <div class="vmpd__header-right">
          <span class="vmpd__status-chip" aria-label="Abo-Status: Aktiv">
            <span class="vmpd__status-dot" aria-hidden="true"></span>
            Pro aktiv
          </span>
          <a class="vmpd__header-logout"
             href="{{ routes.account_logout_url }}"
             aria-label="Ausloggen">
            Ausloggen
          </a>
        </div>
      </header>

      <!-- ── STATS BAR ───────────────────────────────────────────────── -->
      <div class="vmpd__stats" role="list" aria-label="Konto-Übersicht">
        <div class="vmpd__stat" role="listitem">
          <span class="vmpd__stat-label">Status</span>
          <span class="vmpd__stat-value">Aktiv</span>
          <span class="vmpd__stat-sub">VM Pro Mitglied</span>
        </div>
        <div class="vmpd__stat" role="listitem">
          <span class="vmpd__stat-label">Mitglied seit</span>
          <span class="vmpd__stat-value">
            {{ customer.created_at | date: "%m/%Y" }}
          </span>
          <span class="vmpd__stat-sub">{{ customer.created_at | date: "%d. %B %Y" }}</span>
        </div>
        <div class="vmpd__stat" role="listitem">
          <span class="vmpd__stat-label">Bestellungen</span>
          <span class="vmpd__stat-value">{{ customer.orders_count }}</span>
          <span class="vmpd__stat-sub">Gesamt</span>
        </div>
      </div>

      <!-- ── MAIN GRID ───────────────────────────────────────────────── -->
      <div class="vmpd__grid">

        <!-- ── LEFT COLUMN: Bike + Orders ──────────────────────────── -->
        <div>

          <!-- PANEL 1: Gespeichertes Rad -->
          <article class="vmpd__panel" aria-labelledby="vmpd-bike-heading">
            <div class="vmpd__panel-hd">
              <span class="vmpd__panel-num">01</span>
              <h2 class="vmpd__panel-title" id="vmpd-bike-heading">Gespeichertes Rad</h2>
              <a class="vmpd__panel-action" href="/" aria-label="Rad neu konfigurieren">
                Ändern →
              </a>
            </div>
            <div class="vmpd__panel-body" id="vmpd-bike-body"></div>
          </article>

          <!-- PANEL 2: Kaufhistorie -->
          <article class="vmpd__panel" aria-labelledby="vmpd-orders-heading">
            <div class="vmpd__panel-hd">
              <span class="vmpd__panel-num">02</span>
              <h2 class="vmpd__panel-title" id="vmpd-orders-heading">Kaufhistorie</h2>
              {%- if customer.orders_count > 5 -%}
                <a class="vmpd__panel-action" href="{{ routes.account_url }}" aria-label="Alle Bestellungen ansehen">
                  Alle ansehen →
                </a>
              {%- endif -%}
            </div>
            <div class="vmpd__panel-body">

              {%- if customer.orders.size > 0 -%}
                <table class="vmpd__orders-table" aria-label="Bestellhistorie">
                  <thead>
                    <tr>
                      <th scope="col">Bestellung</th>
                      <th scope="col">Datum</th>
                      <th scope="col">Gesamt</th>
                      <th scope="col">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for order in customer.orders limit: 5 -%}
                      <tr>
                        <td>
                          <a class="vmpd__order-num"
                             href="{{ order.customer_url }}"
                             aria-label="Bestellung {{ order.name }} öffnen">
                            {{ order.name }}
                          </a>
                        </td>
                        <td>
                          <span class="vmpd__order-date">
                            {{ order.created_at | date: "%d.%m.%Y" }}
                          </span>
                        </td>
                        <td>
                          <span class="vmpd__order-total">
                            {{ order.total_price | money }}
                          </span>
                        </td>
                        <td>
                          {%- case order.financial_status -%}
                            {%- when 'paid' -%}
                              <span class="vmpd__order-badge vmpd__order-badge--paid">Bezahlt</span>
                            {%- when 'pending' -%}
                              <span class="vmpd__order-badge vmpd__order-badge--pending">Ausstehend</span>
                            {%- when 'refunded', 'voided' -%}
                              <span class="vmpd__order-badge vmpd__order-badge--refunded">Erstattet</span>
                            {%- else -%}
                              <span class="vmpd__order-badge vmpd__order-badge--pending">{{ order.financial_status }}</span>
                          {%- endcase -%}
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>

              {%- else -%}
                <p class="vmpd__orders-empty">
                  Noch keine Bestellungen. Deine ersten Käufe erscheinen hier.
                </p>
              {%- endif -%}

            </div>
          </article>

        </div>
        <!-- /left column -->

        <!-- ── RIGHT COLUMN: Strava + Konto ────────────────────────── -->
        <div>

          <!-- PANEL 3: Strava -->
          <article class="vmpd__panel" aria-labelledby="vmpd-strava-heading">
            <div class="vmpd__panel-hd">
              <span class="vmpd__panel-num">03</span>
              <h2 class="vmpd__panel-title" id="vmpd-strava-heading">Strava</h2>
            </div>
            <div class="vmpd__panel-body" id="vmpd-strava-body"></div>
          </article>

          <!-- PANEL 4: Konto-Einstellungen -->
          <article class="vmpd__panel" aria-labelledby="vmpd-account-heading">
            <div class="vmpd__panel-hd">
              <span class="vmpd__panel-num">04</span>
              <h2 class="vmpd__panel-title" id="vmpd-account-heading">Konto</h2>
            </div>
            <div class="vmpd__panel-body" style="padding-top: 8px; padding-bottom: 8px;">
              <ul class="vmpd__account-links" role="list">

                <li class="vmpd__account-link-item" role="listitem">
                  <a class="vmpd__account-link" href="{{ routes.account_url }}">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Konto-Übersicht
                    <span class="vmpd__account-link-arr" aria-hidden="true">→</span>
                  </a>
                </li>

                <li class="vmpd__account-link-item" role="listitem">
                  <a class="vmpd__account-link"
                     href="{{ routes.account_url }}/addresses">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    Adressbuch
                    <span class="vmpd__account-link-arr" aria-hidden="true">→</span>
                  </a>
                </li>

                <li class="vmpd__account-link-item" role="listitem">
                  <a class="vmpd__account-link"
                     href="/pages/velomatch-pro"
                     aria-label="VM Pro Abo-Informationen">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                    VM Pro Vorteile
                    <span class="vmpd__account-link-arr" aria-hidden="true">→</span>
                  </a>
                </li>

                <li class="vmpd__account-link-item" role="listitem">
                  <a class="vmpd__account-link"
                     href="{{ routes.account_logout_url }}"
                     aria-label="Vom Konto ausloggen">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                      <polyline points="16 17 21 12 16 7"/>
                      <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Ausloggen
                    <span class="vmpd__account-link-arr" aria-hidden="true">→</span>
                  </a>
                </li>

              </ul>
            </div>
          </article>

        </div>
        <!-- /right column -->

      </div>
      <!-- /vmpd__grid -->

    </div>
  </div>

  <script>
  (function () {
    var SEARCH_SVG = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>';
    var BIKE_SVG   = '<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--vm-sage);opacity:.45"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h3.5"/><path d="M5.5 14L9 10"/></svg>';

    function esc(s) {
      return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ── Parse customer.note ───────────────────────────────────────────────── */
    var noteData = null;
    try {
      noteData = typeof window.__vmProNote === 'string'
        ? JSON.parse(window.__vmProNote)
        : window.__vmProNote;
    } catch (e) {}

    /* ── Handle ?strava= URL param ─────────────────────────────────────────── */
    var urlParams   = new URLSearchParams(window.location.search);
    var stravaParam = urlParams.get('strava');
    var justConnected = false;

    if (stravaParam) {
      history.replaceState({}, '', window.location.pathname);
      if (stravaParam === 'connected') {
        try { localStorage.setItem('vm_strava_connected_ts', String(Date.now())); } catch(e) {}
        justConnected = true;
      }
    }
    if (!justConnected) {
      try {
        var ts = parseInt(localStorage.getItem('vm_strava_connected_ts') || '0');
        if (Date.now() - ts < 60000) justConnected = true;
      } catch(e) {}
    }

    /* ── BIKE PANEL ────────────────────────────────────────────────────────── */
    var bikeBody = document.getElementById('vmpd-bike-body');
    if (bikeBody) {
      var bike = null;
      if (noteData && noteData.vm_bike && noteData.vm_bike.collectionTag) {
        bike = noteData.vm_bike;
        try { localStorage.setItem('vm_pro_saved_bike', JSON.stringify({ vm_bike: bike })); } catch(e) {}
      }
      if (!bike) {
        try {
          var loc = JSON.parse(localStorage.getItem('vm_pro_saved_bike') || 'null');
          if (loc && loc.vm_bike && loc.vm_bike.collectionTag) bike = loc.vm_bike;
        } catch(e) {}
      }

      if (bike) {
        var specs = '';
        if (bike.variant)      specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Variante</span><span class="vmpd__bike-spec-value">' + esc(bike.variant) + '</span></div>';
        if (bike.schaltgruppe) specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Schaltgruppe</span><span class="vmpd__bike-spec-value">' + esc(bike.schaltgruppe) + '</span></div>';
        if (bike.modelljahre)  specs += '<div class="vmpd__bike-spec"><span class="vmpd__bike-spec-label">Modelljahre</span><span class="vmpd__bike-spec-value">' + esc(bike.modelljahre) + '</span></div>';

        bikeBody.innerHTML =
          (bike.brand ? '<p class="vmpd__bike-brand">' + esc(bike.brand) + '</p>' : '') +
          (bike.model ? '<p class="vmpd__bike-model">' + esc(bike.model) + '</p>' : '') +
          (specs ? '<div class="vmpd__bike-specs">' + specs + '</div>' : '') +
          '<a class="vmpd__parts-btn" href="/collections/all?filter.p.tag=' + encodeURIComponent(bike.collectionTag) + '">' +
          SEARCH_SVG + ' Passende Teile finden →</a>';
      } else {
        bikeBody.innerHTML =
          '<div class="vmpd__empty" role="status">' + BIKE_SVG +
          '<p class="vmpd__empty-label">Noch kein Rad gespeichert. W\xe4hle dein Fahrrad im Konfigurator aus.</p>' +
          '<a class="vmpd__selector-link" href="/">Rad konfigurieren →</a></div>';
      }
    }

    /* ── STRAVA PANEL ──────────────────────────────────────────────────────── */
    var stravaBody = document.getElementById('vmpd-strava-body');
    if (!stravaBody) return;

    var strava = (noteData && noteData.strava && noteData.strava.athlete_id) ? noteData.strava : null;
    var tokenExpired = strava && strava.token_expires_at && (Date.now() / 1000 > strava.token_expires_at);

    var RIDE_LABELS = {
      'Ride': 'Rennrad', 'MountainBikeRide': 'Mountainbike',
      'GravelRide': 'Gravel', 'VirtualRide': 'Indoor', 'EBikeRide': 'E-Bike'
    };

    if (strava && !tokenExpired) {
      var a = strava.athlete;
      var p = strava.profile;

      var isDefaultAvatar = !a.profile || a.profile.indexOf('large.jpg') !== -1;
      var avatarHtml = isDefaultAvatar
        ? '<div class="vmpd__strava-logo vmpd__strava-athlete-img" aria-hidden="true">S</div>'
        : '<img class="vmpd__strava-athlete-img" src="' + esc(a.profile) + '" alt="" loading="lazy">';

      function fmtKm(km) {
        if (km == null) return '\u2014';
        return km.toLocaleString('de-DE') + ' km';
      }

      var statsHtml =
        '<div class="vmpd__strava-stats">' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + fmtKm(p.ytd_distance_km) + '</span><span class="vmpd__strava-stat-lbl">Dieses Jahr</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + (p.ytd_rides != null ? p.ytd_rides : '\u2014') + '</span><span class="vmpd__strava-stat-lbl">Fahrten (Jahr)</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + (p.avg_ride_distance_km ? p.avg_ride_distance_km + ' km' : '\u2014') + '</span><span class="vmpd__strava-stat-lbl">\xd8 Distanz</span></div>' +
        '<div class="vmpd__strava-stat-cell"><span class="vmpd__strava-stat-val">' + fmtKm(p.all_time_distance_km) + '</span><span class="vmpd__strava-stat-lbl">Gesamt</span></div>' +
        '</div>';

      var typeHtml = p.dominant_ride_type
        ? '<span class="vmpd__strava-type-badge">Fahrstil: ' + esc(RIDE_LABELS[p.dominant_ride_type] || p.dominant_ride_type) + '</span>'
        : '';

      var bikesHtml = '';
      if (a.bikes && a.bikes.length) {
        bikesHtml = '<div class="vmpd__strava-bikes"><span class="vmpd__strava-bikes-label">Fahrr\xe4der auf Strava</span>';
        a.bikes.forEach(function(b) {
          bikesHtml += '<div class="vmpd__strava-bike-row"><span>' + esc(b.name) + '</span>' +
            (b.distance_km ? '<span class="vmpd__strava-bike-km">' + b.distance_km.toLocaleString('de-DE') + ' km</span>' : '') + '</div>';
        });
        bikesHtml += '</div>';
      }

      var connDate = '';
      try { connDate = new Date(strava.connected_at).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' }); } catch(e) {}

      stravaBody.innerHTML =
        '<div class="vmpd__strava-athlete">' + avatarHtml +
        '<div><p class="vmpd__strava-athlete-name">' + esc(a.firstname) + ' ' + esc(a.lastname) + '</p>' +
        '<span class="vmpd__strava-connected-meta">Verbunden \xb7 ' + connDate + '</span></div></div>' +
        statsHtml + typeHtml + bikesHtml +
        '<a class="vmpd__strava-reconnect" href="/apps/vm-pro/strava/connect">Daten aktualisieren</a>';

    } else if (justConnected && !strava) {
      stravaBody.innerHTML =
        '<div class="vmpd__strava-pending">Strava verbunden — Daten werden geladen…' +
        '<span class="vmpd__strava-pending-reload" onclick="window.location.reload()">Seite aktualisieren</span></div>';
      setTimeout(function() { window.location.reload(); }, 3000);

    } else {
      var msg = tokenExpired
        ? 'Deine Strava-Verbindung ist abgelaufen. Bitte neu verbinden.'
        : 'Verbinde deinen Strava-Account, um Aktivit\xe4tsdaten zu sammeln und Produkt-Empfehlungen zu personalisieren.';

      stravaBody.innerHTML =
        '<div class="vmpd__strava-connect-wrap">' +
        '<div class="vmpd__strava-row"><div class="vmpd__strava-logo" aria-hidden="true">S</div>' +
        '<div><h3 class="vmpd__strava-info-heading">Strava verkn\xfcpfen</h3>' +
        '<p class="vmpd__strava-desc">' + msg + '</p></div></div>' +
        '<a class="vmpd__strava-connect-btn" href="/apps/vm-pro/strava/connect">Mit Strava verbinden →</a></div>';
    }
  })();
  </script>

{%- else -%}
  <div class="vmpd">
    <div class="vmpd__inner" style="padding-top: 64px;">
      <div class="vmpd__gate">
        <div class="vmpd__gate-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="0" ry="0"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1 class="vmpd__gate-heading">Exklusiv für<br>VM Pro Mitglieder</h1>
