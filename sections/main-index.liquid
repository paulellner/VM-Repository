<style>
.vm-hero {
  background:   var(--vm-ink);
  color:        var(--vm-bone);
  padding:      96px 40px;
  text-align:   center;
  border-bottom: 2.5px solid var(--vm-ink);
}

.vm-hero__inner { max-width: 800px; margin: 0 auto; }

.vm-hero__label {
  font-family:    var(--vm-mono);
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color:          var(--vm-signal);
  margin-bottom:  24px;
  display:        block;
}

.vm-hero__h1 {
  font-size:      72px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.035em;
  line-height:    0.92;
  margin:         0 0 32px;
}

.vm-hero__sub {
  font-size:   18px;
  opacity:     0.65;
  line-height: 1.5;
  max-width:   560px;
  margin:      0 auto 40px;
  text-transform: none;
  font-weight: 400;
  letter-spacing: 0;
}

.vm-hero__cta {
  display:        inline-flex;
  align-items:    center;
  gap:            12px;
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  text-decoration: none;
  font-weight:    800;
  font-size:      15px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding:        16px 32px;
  transition:     box-shadow 220ms ease, transform 220ms ease;
}

@media (prefers-reduced-motion: no-preference) {
  .vm-hero__cta:hover {
    transform:  translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--vm-olive);
  }
}

@media (max-width: 880px) {
  .vm-hero          { padding: 64px 20px; }
  .vm-hero__h1      { font-size: 44px; }
}
</style>

<div class="vm-hero">
  <div class="vm-hero__inner">
    <span class="vm-hero__label">{{ section.settings.label | default: 'Bike Selector' }}</span>
    <h1 class="vm-hero__h1">{{ section.settings.heading | default: 'Die richtigen Teile für dein Rad.' }}</h1>
    <p class="vm-hero__sub">{{ section.settings.subheading | default: 'Wähle dein Fahrrad in drei Schritten — wir zeigen dir nur die Teile, die wirklich passen.' }}</p>
    <a class="vm-hero__cta" href="{{ section.settings.cta_url | default: '#bike-selector' }}">
      {{ section.settings.cta_text | default: 'Jetzt Fahrrad wählen' }} →
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label (klein, oben)",
      "default": "Bike Selector"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Die richtigen Teile für dein Rad."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertext",
      "default": "Wähle dein Fahrrad in drei Schritten — wir zeigen dir nur die Teile, die wirklich passen."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Jetzt Fahrrad wählen"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
