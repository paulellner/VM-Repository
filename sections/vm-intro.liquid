<style>
/* ── VeloMatch Intro — Vollbild-Hero ─────────────────────────────────── */
.vm-intro {
  position:       relative;
  overflow:       hidden;
  min-height:     100svh;
  display:        flex;
  flex-direction: column;
  color:          var(--vm-bone);
}

/* Background photo */
.vm-intro__bg {
  position:            absolute;
  inset:               0;
  background-size:     cover;
  background-position: center 40%;
  background-repeat:   no-repeat;
  {%- if section.settings.hero_image != blank -%}
  background-image: url("{{ section.settings.hero_image | image_url: width: 2400 }}");
  {%- else -%}
  background-image: url("{{ 'vm-hero-bg.png' | asset_url }}");
  {%- endif -%}
  filter:  saturate({{ section.settings.saturation | default: 70 }}%) brightness({{ section.settings.brightness | default: 88 }}%);
  z-index: 0;
}

/* Overlay */
.vm-intro__overlay {
  position: absolute;
  inset:    0;
  background:
    linear-gradient(148deg, rgba(61,74,47,0.50) 0%, rgba(20,22,15,0.0) 45%),
    linear-gradient(
      to bottom,
      rgba(20,22,15,0.20) 0%,
      rgba(20,22,15,0.08) 28%,
      rgba(20,22,15,0.58) 68%,
      rgba(20,22,15,0.90) 100%
    );
  z-index: 1;
}

/* Content above overlay */
.vm-intro__content,
.vm-intro__lower {
  position: relative;
  z-index:  2;
}

/* ── Main Content — pushed to bottom ────────────────────────────────── */
.vm-intro__content {
  margin-top: auto;
  padding:    0 48px 12px;
  max-width:  860px;
}

.vm-intro__eyebrow {
  display:        flex;
  align-items:    center;
  gap:            10px;
  font-family:    var(--vm-mono);
  font-size:      10px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color:          var(--vm-signal);
  margin-bottom:  22px;
}
.vm-intro__eyebrow::before {
  content:    '';
  display:    inline-block;
  width:      28px;
  height:     1px;
  background: var(--vm-signal);
  flex-shrink: 0;
}

.vm-intro__headline {
  font-family:    'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:      clamp(48px, 7vw, 96px);
  font-weight:    400;
  letter-spacing: -0.045em;
  line-height:    1.0;
  text-transform: none;
  color:          var(--vm-bone);
  margin:         0 0 28px;
}
.vm-intro__headline em {
  font-style: normal;
  color:      var(--vm-signal);
}

.vm-intro__sub {
  font-size:      clamp(14px, 1.6vw, 17px);
  line-height:    1.55;
  color:          rgba(245,241,232,0.68);
  max-width:      520px;
  margin:         0;
  font-weight:    400;
  text-transform: none;
  letter-spacing: 0;
}

/* ── Stats Bar ──────────────────────────────────────────────────────── */
.vm-intro__lower {
  border-top:  1px solid rgba(245,241,232,0.1);
  margin-top:  48px;
  padding:     22px 48px;
  display:     flex;
  align-items: center;
}

.vm-intro__stats {
  display:  flex;
  flex-wrap: wrap;
}

.vm-intro__stat {
  padding-right:  32px;
  margin-right:   32px;
  border-right:   1px solid rgba(245,241,232,0.14);
}
.vm-intro__stat:last-child {
  border-right: none;
  margin-right: 0;
  padding-right: 0;
}

.vm-intro__stat-num {
  display:        block;
  font-family:    var(--vm-mono);
  font-size:      24px;
  font-weight:    400;
  color:          var(--vm-signal);
  line-height:    1;
  letter-spacing: -0.02em;
}
.vm-intro__stat-lbl {
  display:        block;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color:          rgba(245,241,232,0.45);
  margin-top:     5px;
}

.vm-intro__scroll {
  margin-left:    auto;
  display:        flex;
  align-items:    center;
  gap:            8px;
  font-family:    var(--vm-mono);
  font-size:      9px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color:          rgba(245,241,232,0.3);
}
@keyframes vm-bounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(5px); }
}
@media (prefers-reduced-motion: no-preference) {
  .vm-intro__scroll-icon { animation: vm-bounce 1.8s infinite ease-in-out; }
}

/* ── Responsive ─────────────────────────────────────────────────────── */
@media (max-width: 960px) {
  .vm-intro__content { padding: 0 24px 12px; max-width: 100%; }
  .vm-intro__lower   { padding: 18px 24px; }
}
@media (max-width: 600px) {
  .vm-intro__stats   { flex-direction: column; gap: 16px; }
  .vm-intro__stat    { border-right: none; margin-right: 0; padding-right: 0; }
  .vm-intro__scroll  { display: none; }
}
</style>

<section class="vm-intro">

  <div class="vm-intro__bg" aria-hidden="true"></div>
  <div class="vm-intro__overlay" aria-hidden="true"></div>

  <!-- ── Hero Copy ─────────────────────────────────────────────────────── -->
  <div class="vm-intro__content">
    <p class="vm-intro__eyebrow">{{ section.settings.eyebrow | default: 'velomatch PRO' }}</p>
    <h1 class="vm-intro__headline">
      Dein Rad.<br>
      Deine Daten.<br>
      Deine <em>Teile.</em>
    </h1>
    <p class="vm-intro__sub">{{ section.settings.subtext | default: 'Verschlei&szlig;tracking, Strava-Integration und smarte Kaufvorschl&auml;ge &mdash; alles in einem Dashboard. F&uuml;r Fahrer, die es ernst meinen.' }}</p>
  </div>

  <!-- ── Stats Bar ─────────────────────────────────────────────────────── -->
  <div class="vm-intro__lower">
    <div class="vm-intro__stats" role="list">
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat1_num | default: '12' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat1_lbl | default: 'Marken' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat2_num | default: '88' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat2_lbl | default: 'Modellreihen' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat3_num | default: '247' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat3_lbl | default: 'Varianten' }}</span>
      </div>
    </div>
    <div class="vm-intro__scroll" aria-hidden="true">
      <span class="vm-intro__scroll-icon">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
      </span>
      Scrollen
    </div>
  </div>

</section>

{% schema %}
{
  "name": "VeloMatch Intro",
  "settings": [
    {
      "type": "header",
      "content": "Hero-Bild"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hintergrundbild",
      "info": "Mind. 2000px breit, Querformat. Lade hier dein Hero-Foto hoch."
    },
    {
      "type": "range",
      "id": "saturation",
      "label": "Sättigung",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "brightness",
      "label": "Helligkeit",
      "min": 50,
      "max": 100,
      "step": 2,
      "default": 88,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Texte"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (klein, oben)",
      "default": "velomatch PRO"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Beschreibungstext",
      "default": "Verschleißtracking, Strava-Integration und smarte Kaufvorschläge — alles in einem Dashboard. Für Fahrer, die es ernst meinen."
    },
    {
      "type": "header",
      "content": "Statistiken"
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Zahl",
      "default": "12"
    },
    {
      "type": "text",
      "id": "stat1_lbl",
      "label": "Stat 1 Label",
      "default": "Marken"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Zahl",
      "default": "88"
    },
    {
      "type": "text",
      "id": "stat2_lbl",
      "label": "Stat 2 Label",
      "default": "Modellreihen"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 Zahl",
      "default": "247"
    },
    {
      "type": "text",
      "id": "stat3_lbl",
      "label": "Stat 3 Label",
      "default": "Varianten"
    }
  ],
  "presets": [
    {
      "name": "VeloMatch Intro",
      "category": "VeloMatch"
    }
  ]
}
{% endschema %}
