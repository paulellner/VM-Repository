<style>
/* ── VeloMatch Intro — erscheint direkt über dem Selector ─────────────── */
.vm-intro {
  background:   var(--vm-ink);
  color:        var(--vm-bone);
  padding:      80px 40px 72px;
  text-align:   center;
  border-bottom: 2.5px solid var(--vm-signal);
}

.vm-intro__inner {
  max-width: 860px;
  margin:    0 auto;
}

/* Logo / Wordmark */
.vm-intro__logo {
  font-family:    'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:      clamp(52px, 8vw, 96px);
  letter-spacing: -0.045em;
  line-height:    1;
  display:        block;
  text-decoration: none;
  color:          var(--vm-bone);
  margin-bottom:  32px;
}
.vm-intro__logo-velo  { font-weight: 400; }
.vm-intro__logo-match { font-weight: 700; }
.vm-intro__logo-dot   { color: var(--vm-signal); }

/* Stats bar */
.vm-intro__stats {
  display:         flex;
  justify-content: center;
  align-items:     center;
  gap:             0;
  margin-bottom:   40px;
  border:          1.5px solid rgba(156, 169, 130, 0.25);
  display:         inline-flex;
  overflow:        hidden;
}

.vm-intro__stat {
  padding:        14px 28px;
  border-right:   1.5px solid rgba(156, 169, 130, 0.25);
  text-align:     center;
}
.vm-intro__stat:last-child { border-right: none; }

.vm-intro__stat-num {
  display:        block;
  font-family:    var(--vm-mono);
  font-size:      28px;
  font-weight:    400;
  color:          var(--vm-signal);
  line-height:    1;
  letter-spacing: -0.02em;
}

.vm-intro__stat-lbl {
  display:        block;
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  margin-top:     6px;
}

/* USP copy */
.vm-intro__headline {
  font-size:      clamp(22px, 3.5vw, 32px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height:    1.05;
  margin:         0 0 20px;
}

.vm-intro__sub {
  font-size:   17px;
  line-height: 1.6;
  color:       var(--vm-sage);
  max-width:   560px;
  margin:      0 auto 40px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* Steps preview */
.vm-intro__steps {
  display:         flex;
  justify-content: center;
  gap:             0;
  margin-bottom:   40px;
}

.vm-intro__step {
  display:     flex;
  align-items: center;
  gap:         10px;
  font-size:   13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color:       var(--vm-sage);
}

.vm-intro__step-num {
  font-family: var(--vm-mono);
  font-size:   11px;
  width:       22px;
  height:      22px;
  border:      1.5px solid var(--vm-moss);
  display:     flex;
  align-items: center;
  justify-content: center;
  color:       var(--vm-signal);
  flex-shrink: 0;
}

.vm-intro__step-arrow {
  color:      var(--vm-moss);
  margin:     0 16px;
  font-size:  16px;
}

/* CTA arrow */
.vm-intro__arrow {
  display:        flex;
  align-items:    center;
  justify-content: center;
  gap:            10px;
  font-family:    var(--vm-mono);
  font-size:      12px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  opacity:        0.7;
}

@keyframes vm-bounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(6px); }
}

@media (prefers-reduced-motion: no-preference) {
  .vm-intro__arrow-icon { animation: vm-bounce 1.8s infinite ease-in-out; }
}

@media (max-width: 880px) {
  .vm-intro        { padding: 56px 20px 48px; }
  .vm-intro__stats { flex-direction: column; }
  .vm-intro__stat  { border-right: none; border-bottom: 1.5px solid rgba(156, 169, 130, 0.25); }
  .vm-intro__stat:last-child { border-bottom: none; }
  .vm-intro__steps { flex-direction: column; gap: 12px; }
  .vm-intro__step-arrow { display: none; }
}
</style>

<div class="vm-intro">
  <div class="vm-intro__inner">

    <!-- Wordmark -->
    <a class="vm-intro__logo" href="{{ routes.root_url }}">
      <span class="vm-intro__logo-velo">velo</span><span class="vm-intro__logo-match">match</span><span class="vm-intro__logo-dot">.</span>
    </a>

    <!-- Stats -->
    <div class="vm-intro__stats" role="list">
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">{{ section.settings.stat1_num | default: '12' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat1_lbl | default: 'Marken' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">{{ section.settings.stat2_num | default: '88' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat2_lbl | default: 'Modellreihen' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">{{ section.settings.stat3_num | default: '247' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat3_lbl | default: 'Varianten' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">{{ section.settings.stat4_num | default: '9' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat4_lbl | default: 'Komponenten' }}</span>
      </div>
    </div>

    <!-- Headline + USP -->
    <h1 class="vm-intro__headline">{{ section.settings.headline | default: 'Nur Teile, die wirklich passen.' }}</h1>
    <p class="vm-intro__sub">{{ section.settings.subtext | default: 'Wähle dein Fahrrad in drei Schritten — Marke, Modell, Ausstattung. VeloMatch zeigt dir danach ausschließlich die Komponenten, die mit deinem konkreten Aufbau kompatibel sind.' }}</p>

    <!-- 3-Step preview -->
    <div class="vm-intro__steps" aria-label="So funktioniert es">
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">1</span>
        Marke wählen
      </div>
      <span class="vm-intro__step-arrow" aria-hidden="true">→</span>
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">2</span>
        Modell wählen
      </div>
      <span class="vm-intro__step-arrow" aria-hidden="true">→</span>
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">3</span>
        Ausstattung wählen
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="vm-intro__arrow" aria-hidden="true">
      <span>Los geht's</span>
      <span class="vm-intro__arrow-icon">↓</span>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "VeloMatch Intro",
  "settings": [
    {
      "type": "header",
      "content": "Überschrift & Text"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Hauptüberschrift",
      "default": "Nur Teile, die wirklich passen."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Beschreibungstext",
      "default": "Wähle dein Fahrrad in drei Schritten — Marke, Modell, Ausstattung. VeloMatch zeigt dir danach ausschließlich die Komponenten, die mit deinem konkreten Aufbau kompatibel sind."
    },
    {
      "type": "header",
      "content": "Statistiken"
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Zahl",
      "default": "12"
    },
    {
      "type": "text",
      "id": "stat1_lbl",
      "label": "Stat 1 Label",
      "default": "Marken"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Zahl",
      "default": "88"
    },
    {
      "type": "text",
      "id": "stat2_lbl",
      "label": "Stat 2 Label",
      "default": "Modellreihen"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 Zahl",
      "default": "247"
    },
    {
      "type": "text",
      "id": "stat3_lbl",
      "label": "Stat 3 Label",
      "default": "Varianten"
    },
    {
      "type": "text",
      "id": "stat4_num",
      "label": "Stat 4 Zahl",
      "default": "9"
    },
    {
      "type": "text",
      "id": "stat4_lbl",
      "label": "Stat 4 Label",
      "default": "Komponenten"
    }
  ],
  "presets": [
    {
      "name": "VeloMatch Intro",
      "category": "VeloMatch"
    }
  ]
}
{% endschema %}
