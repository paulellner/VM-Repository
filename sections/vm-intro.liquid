<style>
/* ── VeloMatch Intro — erscheint direkt über dem Selector ─────────────── */
.vm-intro {
  position:      relative;
  overflow:      hidden;
  background:    var(--vm-ink);
  color:         var(--vm-bone);
  padding:       80px 40px 72px;
  text-align:    center;
  border-bottom: 2.5px solid var(--vm-signal);
}

/* Background photo — desaturated, darkened, framed on the rider */
.vm-intro::before {
  content:             '';
  position:            absolute;
  inset:               0;
  background-image:    url("{{ 'vm-hero-bg.png' | asset_url }}");
  background-size:     cover;
  background-position: center 35%;
  filter:              grayscale(55%) contrast(1.35) brightness(0.35);
  z-index:             0;
}

/* Dual-layer overlay: diagonal olive tint + vertical fade-to-ink at bottom */
.vm-intro::after {
  content:  '';
  position: absolute;
  inset:    0;
  background:
    linear-gradient(148deg, rgba(61,74,47,0.65) 0%, rgba(20,22,15,0.0) 48%),
    linear-gradient(to bottom, rgba(20,22,15,0.08) 0%, rgba(20,22,15,0.45) 60%, rgba(20,22,15,0.88) 100%);
  z-index:  1;
}

.vm-intro__inner {
  position:  relative;
  z-index:   2;
  max-width: 860px;
  margin:    0 auto;
}

/* Logo / Wordmark */
.vm-intro__logo {
  font-family:    'Space Grotesk', 'Helvetica Neue', Arial, sans-serif;
  font-size:      clamp(52px, 8vw, 96px);
  letter-spacing: -0.045em;
  line-height:    1;
  display:        block;
  text-decoration: none;
  color:          var(--vm-bone);
  margin-bottom:  32px;
}
.vm-intro__logo-velo  { font-weight: 400; }
.vm-intro__logo-match { font-weight: 700; }
.vm-intro__logo-dot   { color: var(--vm-signal); }

/* Stats bar */
.vm-intro__stats {
  display:         flex;
  justify-content: center;
  align-items:     center;
  gap:             0;
  margin-bottom:   40px;
  border:          1.5px solid rgba(156, 169, 130, 0.25);
  display:         inline-flex;
  overflow:        hidden;
}

.vm-intro__stat {
  padding:        14px 28px;
  border-right:   1.5px solid rgba(156, 169, 130, 0.25);
  text-align:     center;
}
.vm-intro__stat:last-child { border-right: none; }

.vm-intro__stat-num {
  display:        block;
  font-family:    var(--vm-mono);
  font-size:      28px;
  font-weight:    400;
  color:          var(--vm-signal);
  line-height:    1;
  letter-spacing: -0.02em;
}

.vm-intro__stat-lbl {
  display:        block;
  font-size:      11px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  margin-top:     6px;
}

/* USP copy */
.vm-intro__headline {
  font-size:      clamp(22px, 3.5vw, 32px);
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  line-height:    1.05;
  margin:         0 0 20px;
}

.vm-intro__sub {
  font-size:   17px;
  line-height: 1.6;
  color:       var(--vm-sage);
  max-width:   560px;
  margin:      0 auto 40px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: 0;
}

/* Steps preview */
.vm-intro__steps {
  display:         flex;
  justify-content: center;
  gap:             0;
  margin-bottom:   40px;
}

.vm-intro__step {
  display:     flex;
  align-items: center;
  gap:         10px;
  font-size:   13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color:       var(--vm-sage);
}

.vm-intro__step-num {
  font-family: var(--vm-mono);
  font-size:   11px;
  width:       22px;
  height:      22px;
  border:      1.5px solid var(--vm-moss);
  display:     flex;
  align-items: center;
  justify-content: center;
  color:       var(--vm-signal);
  flex-shrink: 0;
}

.vm-intro__step-arrow {
  color:      var(--vm-moss);
  margin:     0 16px;
  font-size:  16px;
}

/* VM Pro block */
.vm-intro__pro {
  margin-top:    48px;
  border-top:    1px solid rgba(201,228,91,0.18);
  padding-top:   36px;
}
.vm-intro__pro-eyebrow {
  font-family:    var(--vm-sans);
  font-size:      18px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-signal);
  margin-bottom:  28px;
  display:        block;
}
.vm-intro__pro-features {
  display:         flex;
  justify-content: center;
  gap:             0;
  margin-bottom:   28px;
  flex-wrap:       wrap;
}
.vm-intro__pro-feat {
  padding:        20px 28px;
  border-right:   1px solid rgba(201,228,91,0.15);
  text-align:     center;
  min-width:      160px;
  flex:           1;
}
.vm-intro__pro-feat:last-child { border-right: none; }
.vm-intro__pro-feat-icon {
  display:         flex;
  align-items:     center;
  justify-content: center;
  width:           44px;
  height:          44px;
  margin:          0 auto 16px;
  color:           var(--vm-signal);
  border:          1.5px solid rgba(201,228,91,0.3);
  flex-shrink:     0;
}
.vm-intro__pro-feat-icon svg {
  width:  22px;
  height: 22px;
}
.vm-intro__pro-feat-title {
  display:        block;
  font-size:      14px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color:          var(--vm-bone);
  margin-bottom:  4px;
}
.vm-intro__pro-feat-sub {
  display:   block;
  font-size: 12px;
  color:     var(--vm-sage);
  line-height: 1.4;
}
.vm-intro__pro-cta {
  display:         flex;
  align-items:     center;
  justify-content: center;
  gap:             16px;
  flex-wrap:       wrap;
}
.vm-intro__pro-price {
  font-family:    var(--vm-mono);
  font-size:      13px;
  color:          var(--vm-sage);
  letter-spacing: 0.04em;
}
.vm-intro__pro-btn {
  background:     var(--vm-signal);
  color:          var(--vm-ink);
  border:         none;
  padding:        14px 32px;
  font-family:    var(--vm-sans);
  font-size:      13px;
  font-weight:    800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  cursor:         pointer;
  text-decoration: none;
  display:        inline-block;
  transition:     transform 200ms ease, box-shadow 200ms ease;
}
@media (prefers-reduced-motion: no-preference) {
  .vm-intro__pro-btn:hover {
    transform:  translate(-2px,-2px);
    box-shadow: 4px 4px 0 var(--vm-olive);
  }
}
.vm-intro__pro-btn:disabled {
  background: var(--vm-olive);
  color:      var(--vm-signal);
  cursor:     default;
  transform:  none;
  box-shadow: none;
}

/* CTA arrow */
.vm-intro__arrow {
  display:        flex;
  align-items:    center;
  justify-content: center;
  gap:            10px;
  font-family:    var(--vm-mono);
  font-size:      12px;
  font-weight:    700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color:          var(--vm-sage);
  opacity:        0.7;
}

@keyframes vm-bounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(6px); }
}

@media (prefers-reduced-motion: no-preference) {
  .vm-intro__arrow-icon { animation: vm-bounce 1.8s infinite ease-in-out; }
}

@media (max-width: 880px) {
  .vm-intro        { padding: 56px 20px 48px; }
  .vm-intro__stats { flex-direction: column; }
  .vm-intro__stat  { border-right: none; border-bottom: 1.5px solid rgba(156, 169, 130, 0.25); }
  .vm-intro__stat:last-child { border-bottom: none; }
  .vm-intro__steps { flex-direction: column; gap: 12px; }
  .vm-intro__step-arrow { display: none; }
}
</style>

<div class="vm-intro">
  <div class="vm-intro__inner">

    <!-- Wordmark -->
    <a class="vm-intro__logo" href="{{ routes.root_url }}">
      <span class="vm-intro__logo-velo">velo</span><span class="vm-intro__logo-match">match</span><span class="vm-intro__logo-dot">.</span>
    </a>

    <!-- Stats -->
    <div class="vm-intro__stats" role="list">
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat1_num | default: '12' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat1_lbl | default: 'Marken' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat2_num | default: '88' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat2_lbl | default: 'Modellreihen' }}</span>
      </div>
      <div class="vm-intro__stat" role="listitem">
        <span class="vm-intro__stat-num">+{{ section.settings.stat3_num | default: '247' }}</span>
        <span class="vm-intro__stat-lbl">{{ section.settings.stat3_lbl | default: 'Varianten' }}</span>
      </div>

    </div>

    <!-- Headline + USP -->
    <h1 class="vm-intro__headline">{{ section.settings.headline | default: 'Nur Teile, die wirklich passen.' }}</h1>
    <p class="vm-intro__sub">{{ section.settings.subtext | default: 'Wähle dein Fahrrad in drei Schritten — Marke, Modell, Ausstattung. VeloMatch zeigt dir danach ausschließlich die Komponenten, die mit deinem konkreten Aufbau kompatibel sind.' }}</p>

    <!-- 3-Step preview -->
    <div class="vm-intro__steps" aria-label="So funktioniert es">
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">1</span>
        Marke wählen
      </div>
      <span class="vm-intro__step-arrow" aria-hidden="true">→</span>
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">2</span>
        Modell wählen
      </div>
      <span class="vm-intro__step-arrow" aria-hidden="true">→</span>
      <div class="vm-intro__step">
        <span class="vm-intro__step-num">3</span>
        Ausstattung wählen
      </div>
    </div>

    <!-- VM Pro section -->
    <div class="vm-intro__pro">
      <span class="vm-intro__pro-eyebrow">★ VeloMatch Pro — 5.99€/Monat</span>
      <div class="vm-intro__pro-features">
        <div class="vm-intro__pro-feat">
          <span class="vm-intro__pro-feat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </span>
          <span class="vm-intro__pro-feat-title">Rad speichern</span>
          <span class="vm-intro__pro-feat-sub">Dein Bike dauerhaft in deinem Profil hinterlegt</span>
        </div>
        <div class="vm-intro__pro-feat">
          <span class="vm-intro__pro-feat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
          </span>
          <span class="vm-intro__pro-feat-title">Strava verknüpfen</span>
          <span class="vm-intro__pro-feat-sub">Verschleißteile & Reiniger automatisch bestellt — auf Basis deiner Fahrdaten</span>
        </div>
        <div class="vm-intro__pro-feat">
          <span class="vm-intro__pro-feat-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </span>
          <span class="vm-intro__pro-feat-title">Kaufhistorie</span>
          <span class="vm-intro__pro-feat-sub">Alle Ersatzteile und Upgrades auf einen Blick</span>
        </div>
      </div>
      <div class="vm-intro__pro-cta">
        {%- if customer and customer.tags contains 'vm-pro' -%}
          <button class="vm-intro__pro-btn" disabled>★ Du bist bereits Pro</button>
        {%- else -%}
          <a class="vm-intro__pro-btn" href="/pages/velomatch-pro">Alle Vorteile →</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<script>
function vmProAddToCart(btn) {
  btn.disabled = true;
  var orig = btn.textContent;
  btn.textContent = '...';

  function addByHandle(handle) {
    return fetch('/products/' + handle + '.json')
      .then(function(r) {
        if (!r.ok) throw new Error('404');
        return r.json();
      })
      .then(function(d) {
        var variant = d.product.variants[0];
        var payload = { id: variant.id, quantity: 1 };
        var spg = d.product.selling_plan_groups;
        if (spg && spg.length > 0 && spg[0].selling_plans && spg[0].selling_plans.length > 0) {
          payload.selling_plan = spg[0].selling_plans[0].id;
        }
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      })
      .then(function(r) {
        if (!r.ok) return r.json().then(function(e) { throw new Error(e.description || 'cart'); });
        return r.json();
      });
  }

  /* Check cart first — redirect if Pro is already in it */
  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      if (cart.items.some(function(i) { return i.handle === 'velomatch-pro'; })) {
        window.location.href = '/cart';
        return Promise.reject('skip');
      }
      return addByHandle('velomatch-pro')
        .catch(function() {
          return fetch('/search/suggest.json?q=velomatch+pro&resources[type]=product&resources[limit]=1')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var prods = data.resources && data.resources.results && data.resources.results.products;
              if (!prods || prods.length === 0) throw new Error('not-found');
              return addByHandle(prods[0].handle);
            });
        });
    })
    .then(function() { window.location.href = '/cart'; })
    .catch(function(err) {
      if (err === 'skip') return;
      btn.disabled = false;
      btn.textContent = orig;
      window.location.href = '/pages/velomatch-pro';
    });
}
window.vmProAddToCart = vmProAddToCart;
</script>

{% schema %}
{
  "name": "VeloMatch Intro",
  "settings": [
    {
      "type": "header",
      "content": "Überschrift & Text"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Hauptüberschrift",
      "default": "Nur Teile, die wirklich passen."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Beschreibungstext",
      "default": "Wähle dein Fahrrad in drei Schritten — Marke, Modell, Ausstattung. VeloMatch zeigt dir danach ausschließlich die Komponenten, die mit deinem konkreten Aufbau kompatibel sind."
    },
    {
      "type": "header",
      "content": "Statistiken"
    },
    {
      "type": "text",
      "id": "stat1_num",
      "label": "Stat 1 Zahl",
      "default": "12"
    },
    {
      "type": "text",
      "id": "stat1_lbl",
      "label": "Stat 1 Label",
      "default": "Marken"
    },
    {
      "type": "text",
      "id": "stat2_num",
      "label": "Stat 2 Zahl",
      "default": "88"
    },
    {
      "type": "text",
      "id": "stat2_lbl",
      "label": "Stat 2 Label",
      "default": "Modellreihen"
    },
    {
      "type": "text",
      "id": "stat3_num",
      "label": "Stat 3 Zahl",
      "default": "247"
    },
    {
      "type": "text",
      "id": "stat3_lbl",
      "label": "Stat 3 Label",
      "default": "Varianten"
    }
  ],
  "presets": [
    {
      "name": "VeloMatch Intro",
      "category": "VeloMatch"
    }
  ]
}
{% endschema %}
