  /* Fixed component list per spec */
  var COMPS = [
    { n: '01', label: 'Bremsanlage' },
    { n: '02', label: 'Innenlager' },
    { n: '03', label: 'Kurbelgarnitur' },
    { n: '04', label: 'Kassette' },
    { n: '05', label: 'Laufradsatz' },
    { n: '06', label: 'Reifen' },
    { n: '07', label: 'Sattel' },
    { n: '08', label: 'Sattelstütze' },
    { n: '09', label: 'Cockpit' }
  ];

  /* ── STATE ──────────────────────────────────────────────────────────────── */
  var S = { step: 1, brand: null, model: null, variant: null };

  /* ── LOOKUPS ────────────────────────────────────────────────────────────── */
  function findBrand(id) {
    return BIKES.find(function (b) { return b.id === id; });
  }
  function findModel(bid, mid) {
    var b = findBrand(bid);
    return b ? b.models.find(function (m) { return m.id === mid; }) : null;
  }
  function findVariant(bid, mid, vid) {
    var m = findModel(bid, mid);
    return m ? m.variants.find(function (v) { return v.id === vid; }) : null;
  }

  /* ── HELPERS ────────────────────────────────────────────────────────────── */
  function pad(n, total) {
    return ('0' + n).slice(-2) + ' / ' + ('0' + total).slice(-2);
  }

  function esc(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  /* ── CARD RENDERER ──────────────────────────────────────────────────────── */
  function renderCards(container, items, selId, onClick, showType) {
    container.innerHTML = '';
    var realItems = items.filter(function(it) { return it.id !== 'selbst-zusammenstellen'; });
    items.forEach(function (item) {
      var isCustom = item.id === 'selbst-zusammenstellen';
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'vm-pick' + (isCustom ? ' vm-pick--custom' : '');
      btn.setAttribute('role', 'listitem');
      btn.setAttribute('aria-pressed', item.id === selId ? 'true' : 'false');
      if (isCustom) {
        btn.innerHTML =
          '<span class="vm-pick__name">' + esc(item.name) + '</span>' +
          '<div class="vm-pick__meta"><span>' + esc(item.meta) + '</span></div>' +
          '<span class="vm-pick__icon" aria-hidden="true">⊕</span>';
      } else {
        var ri = realItems.indexOf(item) + 1;
        btn.innerHTML =
          '<span class="vm-pick__idx">' + pad(ri, realItems.length) + '</span>' +
          '<span class="vm-pick__name">' + esc(item.name) + '</span>' +
          '<div class="vm-pick__meta">' +
            '<span>' + esc(item.meta) + '</span>' +
            (item.type && showType ? '<span class="vm-pick__chip">' + esc(item.type) + '</span>' : '') +
          '</div>' +
          '<span class="vm-pick__go" aria-hidden="true">→</span>';
      }
      btn.addEventListener('click', function () { onClick(item.id); });
      container.appendChild(btn);
    });
  }

  /* ── STEPPER ────────────────────────────────────────────────────────────── */
  function updateStepper() {
    $segs.forEach(function (seg) {
      var n = parseInt(seg.dataset.seg, 10);
      if (S.step === 'custom') {
        seg.dataset.state = n === 1 ? 'done' : n === 2 ? 'active' : 'idle';
      } else {
        seg.dataset.state = n < S.step ? 'done' : n === S.step ? 'active' : 'idle';
      }
    });
  }

  /* ── BREADCRUMB ─────────────────────────────────────────────────────────── */
  function updateBreadcrumb() {
    if (S.step === 'custom') {
      $back.hidden = false;
      $trail.innerHTML = '<span class="vm-bc__crumb vm-bc__crumb--active">Konfiguration</span>';
      return;
    }
    var parts = [];
    if (S.brand && S.brand !== 'selbst-zusammenstellen') {
      var b = findBrand(S.brand); if (b) parts.push(b.name);
    }
    if (S.model)   { var m = findModel(S.brand, S.model);          if (m) parts.push(m.name); }
    if (S.variant) { var v = findVariant(S.brand, S.model, S.variant); if (v) parts.push(v.name); }

    $back.hidden = parts.length === 0;
    $trail.innerHTML = parts.map(function (p, i) {
      var active = i === parts.length - 1;
      return (i > 0 ? '<span class="vm-bc__sep"> › </span>' : '') +
             '<span class="vm-bc__crumb' + (active ? ' vm-bc__crumb--active' : '') + '">' + esc(p) + '</span>';
    }).join('');
  }

  /* ── VISIBILITY ─────────────────────────────────────────────────────────── */
  function showStep(n) {
    $steps.forEach(function (el) {
      var step = el.dataset.step;
      var match = (n === 'custom') ? (step === 'custom') : (parseInt(step, 10) === n);
      el.setAttribute('aria-hidden', match ? 'false' : 'true');
    });
    $result.setAttribute('aria-hidden', n === 4 ? 'false' : 'true');
  }

  /* ── SCROLL ─────────────────────────────────────────────────────────────── */
  function scrollToSelector() {
    var rect = root.getBoundingClientRect();
    var y = window.pageYOffset + rect.top - 80;
    window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
  }

  /* ── GO TO STEP ─────────────────────────────────────────────────────────── */
  function goTo(n) {
    S.step = n;
    showStep(n);
    updateStepper();
    updateBreadcrumb();
    save();
    if (n === 2) renderCards($gModels, findBrand(S.brand).models, S.model, pickModel, true);
    if (n === 3) renderCards($gVars, findModel(S.brand, S.model).variants, S.variant, pickVariant, true);
    if (n === 4) {
      renderResult();
    }
  }

  /* ── NAVIGATION ─────────────────────────────────────────────────────────── */
  function back() {
    if      (S.step === 2)        { S.model = null; S.variant = null; goTo(1); }
    else if (S.step === 3)        { S.variant = null;                 goTo(2); }
    else if (S.step === 4 && !S.fromCustom) { S.variant = null;      goTo(3); }
    else if (S.step === 4 && S.fromCustom)  { S.variant = null; S.model = null; S.brand = 'selbst-zusammenstellen'; S.fromCustom = false; goToCustom(); }
    else if (S.step === 'custom') { S.brand = null;                   goTo(1); }
    scrollToSelector();
  }

  function reset() {
    S = { step: 1, brand: null, model: null, variant: null, fromCustom: false };
    showStep(1);
    updateStepper();
    updateBreadcrumb();
    renderCards($gBrands, BIKES, null, pickBrand, false);
    clearSave();
    scrollToSelector();
  }

  /* ── PICKERS ────────────────────────────────────────────────────────────── */
  function pickBrand(id) {
    S.brand = id; S.model = null; S.variant = null; S.fromCustom = false;
    renderCards($gBrands, BIKES, id, pickBrand, false);
    if (id === 'selbst-zusammenstellen') {
      setTimeout(function () { goToCustom(); scrollToSelector(); }, 160);
    } else {
      setTimeout(function () { goTo(2); scrollToSelector(); }, 160);
    }
  }

  function pickModel(id) {
    S.model = id; S.variant = null;
    renderCards($gModels, findBrand(S.brand).models, id, pickModel, true);
    setTimeout(function () { goTo(3); scrollToSelector(); }, 160);
  }

  function pickVariant(id) {
    S.variant = id;
    renderCards($gVars, findModel(S.brand, S.model).variants, id, pickVariant, true);
    setTimeout(function () { goTo(4); scrollToSelector(); }, 160);
  }

  /* ── CUSTOM CONFIG ─────────────────────────────────────────────────────── */
  var $customSearch = document.getElementById('vm-custom-search');
  var $customError  = document.getElementById('vm-custom-error');

  function goToCustom() {
    S.step = 'custom';
    showStep('custom');
    updateStepper();
    updateBreadcrumb();
  }

  /* Maps form values → a single custom collectionTag stored in vm_selection */
  function buildCustomTag(hersteller, niveau, antrieb) {
    if (!hersteller) return null;
    var tier = '';
    if (hersteller === 'shimano') {
      if (niveau === 'race')             tier = 'dura-ace-';
      else if (niveau === 'performance') tier = 'ultegra-';
      else if (niveau === 'sport')       tier = '105-';
      else if (niveau === 'einsteiger')  tier = 'tiagra-';
      if (antrieb === 'mechanisch') return 'custom-shimano-' + tier + 'mech';
      return 'custom-shimano-' + tier + 'di2';
    }
    if (hersteller === 'sram') {
      if (niveau === 'race')             tier = 'red-';
      else if (niveau === 'performance') tier = 'force-';
      else if (niveau === 'sport')       tier = 'rival-';
      if (antrieb === 'mechanisch') return 'custom-sram-' + tier + 'mech';
      return 'custom-sram-' + tier + 'axs';
    }
    if (hersteller === 'campagnolo') {
      return 'custom-campagnolo-super-record';
    }
    return null;
  }

  function buildCustomLabel(hersteller, niveau, antrieb) {
    var parts = [];
    if      (hersteller === 'shimano')    parts.push('Shimano');
    else if (hersteller === 'sram')       parts.push('SRAM');
    else if (hersteller === 'campagnolo') parts.push('Campagnolo');
    if      (niveau === 'race')        parts.push('Dura-Ace / Red');
    else if (niveau === 'performance') parts.push('Ultegra / Force');
    else if (niveau === 'sport')       parts.push('105 / Rival');
    else if (niveau === 'einsteiger')  parts.push('Tiagra / Claris');
    if      (antrieb === 'di2')        parts.push('Di2');
    else if (antrieb === 'axs')        parts.push('AXS');
    else if (antrieb === 'mechanisch') parts.push('Mechanisch');
    return parts.join(' ');
  }

  if ($customSearch) {
    $customSearch.addEventListener('click', function () {
      var hersteller = document.getElementById('vm-cfg-hersteller').value;
      var niveau     = document.getElementById('vm-cfg-niveau').value;
      var antrieb    = document.getElementById('vm-cfg-antrieb').value;

      if (!hersteller) {
        if ($customError) $customError.style.display = '';
        return;
      }
      if ($customError) $customError.style.display = 'none';

      var customTag = buildCustomTag(hersteller, niveau, antrieb);
      var label     = buildCustomLabel(hersteller, niveau, antrieb);
      if (!customTag) return;

      try {
        localStorage.setItem('vm_selection', JSON.stringify({
          brand:   'custom',
          model:   'Konfiguriertes Rad',
          variant: customTag,
          label:   label
        }));
      } catch(e) {}

      var collUrl = '{{ section.settings.parts_collection_url | default: "/collections/all" }}';
      window.location.href = collUrl;
    });
  }

  /* ── RESULT PANEL ───────────────────────────────────────────────────────── */
  function renderResult() {
    var b = findBrand(S.brand);
    var m = findModel(S.brand, S.model);
    var v = findVariant(S.brand, S.model, S.variant);
    if (!b || !m || !v) return;

    root.querySelector('[data-r-brand]').textContent   = b.name;
    root.querySelector('[data-r-model]').textContent   = m.name;
    root.querySelector('[data-r-variant]').textContent = v.name;
    root.querySelector('[data-r-schalt]').textContent  = v.schaltgruppe;
    root.querySelector('[data-r-jahre]').textContent   = v.modelljahre;

    /* Update CTA href with collection filter tag */
    if ($cta) {
      var base = $cta.getAttribute('href').split('?')[0];
      $cta.setAttribute('href', base + '?filter.p.tag=' + encodeURIComponent(v.collectionTag));
    }

  }

  /* ── PERSISTENCE ───────────────────────────────────────────────────────── */
  function save() {
    try {
      localStorage.setItem(SK, JSON.stringify({ brand: S.brand, model: S.model, variant: S.variant }));
    } catch (e) {}
  }

  function clearSave() {
    try { localStorage.removeItem(SK); } catch (e) {}
  }

  /* Load bike from customer note (Pro only) — returns true if restored */
  function loadFromAccount() {
    try {
      var d = JSON.parse(PRO_SAVED_NOTE || 'null');
      if (!d || !d.vm_bike) return false;
      var bike = d.vm_bike;
      if (!bike.brand || bike.brand === 'custom') return false;
      var b = findBrand(bike.brand);
      if (!b) return false;
      S.brand = bike.brand;
      if (bike.model && findModel(bike.brand, bike.model)) {
        S.model = bike.model;
        if (bike.variant && findVariant(bike.brand, bike.model, bike.variant)) {
          S.variant = bike.variant;
        }
      }
      var target = S.variant ? 4 : S.model ? 3 : 2;
      renderCards($gBrands, BIKES, S.brand, pickBrand);
      if (target >= 3) renderCards($gModels, b.models, S.model, pickModel);
      if (target >= 4) {
        var mm = findModel(S.brand, S.model);
        if (mm) renderCards($gVars, mm.variants, S.variant, pickVariant);
      }
      goTo(target);
      return true;
    } catch (e) { return false; }
  }

  /* ── INIT ───────────────────────────────────────────────────────────────── */
  $back.addEventListener('click', back);
  $reset.addEventListener('click', reset);

  /* Save button — Pro members only (via App Proxy → Admin API) */
  var $saveBtn = document.getElementById('vm-pro-save-btn');
  if ($saveBtn && IS_PRO) {
    $saveBtn.addEventListener('click', function () {
      var sv = findVariant(S.brand, S.model, S.variant);
      if (!sv) return;

      $saveBtn.disabled    = true;
      $saveBtn.textContent = '…';

      var bikeData = {
        brand:         S.brand,
        model:         S.model,
        variant:       S.variant,
        schaltgruppe:  sv.schaltgruppe,
        modelljahre:   sv.modelljahre,
        collectionTag: sv.collectionTag,
        savedAt:       new Date().toISOString()
      };

      fetch('/apps/vm-pro/save', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ vm_bike: bikeData })
      })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.success) {
          /* Note: kein localStorage-Cache hier — das Dashboard liest das Rad
             live pro Account via App Proxy (sonst Datenleck zwischen Accounts
             im selben Browser). Der Worker schreibt direkt in customer.note. */
          $saveBtn.textContent      = 'Gespeichert ✓';
          $saveBtn.style.background = 'var(--vm-olive)';
          $saveBtn.style.color      = 'var(--vm-bone)';
          setTimeout(function () {
            window.location.href = '/pages/vm-pro-dashboard';
          }, 1200);
        } else {
          $saveBtn.disabled    = false;
          $saveBtn.textContent = 'Fehler — nochmal versuchen';
        }
      })
      .catch(function () {
        $saveBtn.disabled    = false;
        $saveBtn.textContent = 'Fehler — nochmal versuchen';
      });
    });
  }

  clearSave(); /* always clear localStorage — free users start fresh every time */
  var restored = IS_PRO && loadFromAccount();
  if (!restored) {
    renderCards($gBrands, BIKES, null, pickBrand);
  }

})();
</script>

<script>
function vmProAddToCart(btn) {
  btn.disabled = true;
  var orig = btn.textContent;
  btn.textContent = '...';

  function addByHandle(handle) {
    return fetch('/products/' + handle + '.json')
      .then(function(r) {
        if (!r.ok) throw new Error('404');
        return r.json();
      })
      .then(function(d) {
        var variant = d.product.variants[0];
        var payload = { id: variant.id, quantity: 1 };
        var spg = d.product.selling_plan_groups;
        if (spg && spg.length > 0 && spg[0].selling_plans && spg[0].selling_plans.length > 0) {
          payload.selling_plan = spg[0].selling_plans[0].id;
        }
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      })
      .then(function(r) {
        if (!r.ok) return r.json().then(function(e) { throw new Error(e.description || 'cart'); });
        return r.json();
      });
  }

  fetch('/cart.js')
    .then(function(r) { return r.json(); })
    .then(function(cart) {
      if (cart.items.some(function(i) { return i.handle === 'velomatch-pro'; })) {
        window.location.href = '/cart';
        return Promise.reject('skip');
      }
      return addByHandle('velomatch-pro')
        .catch(function() {
          return fetch('/search/suggest.json?q=velomatch+pro&resources[type]=product&resources[limit]=1')
            .then(function(r) { return r.json(); })
            .then(function(data) {
              var prods = data.resources && data.resources.results && data.resources.results.products;
              if (!prods || prods.length === 0) throw new Error('not-found');
              return addByHandle(prods[0].handle);
            });
        });
    })
    .then(function() { window.location.href = '/cart'; })
    .catch(function(err) {
      if (err === 'skip') return;
      btn.disabled = false;
      btn.textContent = orig;
      window.location.href = '/pages/velomatch-pro';
    });
}
window.vmProAddToCart = vmProAddToCart;
</script>

