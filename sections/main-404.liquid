{%- comment -%} 404-Fehlerseite {%- endcomment -%}
<style>
.vm-404 {
  background: var(--vm-bone, #F2F0E6); color: var(--vm-ink, #14160F);
  font-family: 'Helvetica Neue', Arial, sans-serif;
  min-height: 60vh; display: flex; align-items: center; justify-content: center;
  padding: 80px 24px; text-align: center;
}
.vm-404__code {
  font-family: 'Courier New', monospace; font-size: 13px; font-weight: 700;
  letter-spacing: 0.2em; text-transform: uppercase; color: #9CA982; margin-bottom: 16px;
}
.vm-404__title {
  font-size: clamp(32px, 6vw, 64px); font-weight: 800; text-transform: uppercase;
  letter-spacing: -0.03em; line-height: 1; margin: 0 0 20px;
}
.vm-404__text { font-size: 16px; line-height: 1.6; color: #3D4A2F; margin: 0 0 32px; }
.vm-404__btn {
  display: inline-flex; align-items: center; gap: 10px; background: #C9E45B; color: #14160F;
  text-decoration: none; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;
  font-size: 14px; padding: 15px 26px;
}
</style>
<section class="vm-404">
  <div>
    <div class="vm-404__code">Fehler 404</div>
    <h1 class="vm-404__title">Seite nicht gefunden</h1>
    <p class="vm-404__text">Die aufgerufene Seite existiert nicht oder wurde verschoben.</p>
    <a class="vm-404__btn" href="{{ routes.root_url }}">Zur Startseite →</a>
  </div>
</section>
{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
